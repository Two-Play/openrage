// OpenRAGE main window.
// All user-visible strings go through @tr() so the UI can be translated.

import { Button, LineEdit, ComboBox, ScrollView, ListView, Palette, Spinner } from "std-widgets.slint";

export struct TreeRow {
    name: string,
    path: string,
    depth: int,
    expandable: bool,
    expanded: bool,
    badge: string,
    tint: color,
}

export struct FileRow {
    mark-color: color,
    dim: bool,
    name: string,
    badge: string,
    tint: color,
    kind: string,
    size: string,
    info: string,
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    width: 34px;
    height: 16px;
    border-radius: 3px;
    background: tint;
    Text {
        text: root.text;
        color: white;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Splitter inherits Rectangle {
    callback dragged(length);
    width: 5px;
    background: ta.has-hover || ta.pressed ? Palette.accent-background : transparent;
    ta := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

component TreeItem inherits Rectangle {
    in property <TreeRow> item;
    in property <bool> selected;
    callback toggle();
    callback activate();
    height: 22px;
    background: selected ? Palette.selection-background : area.has-hover ? Palette.alternate-background : transparent;
    area := TouchArea {
        clicked => { root.activate(); }
        double-clicked => { root.toggle(); }
    }
    HorizontalLayout {
        padding-left: 4px + item.depth * 14px;
        padding-right: 4px;
        spacing: 4px;
        Rectangle {
            width: 14px;
            Text {
                text: item.expandable ? (item.expanded ? "▾" : "▸") : "";
                color: selected ? Palette.selection-foreground : Palette.foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                clicked => { root.toggle(); }
            }
        }
        Badge {
            y: (parent.height - self.height) / 2;
            text: item.badge;
            tint: item.tint;
        }
        Text {
            text: item.name;
            vertical-alignment: center;
            overflow: elide;
            color: selected ? Palette.selection-foreground : Palette.foreground;
        }
    }
}

component FileItem inherits Rectangle {
    opacity: item.dim ? 0.5 : 1.0;
    in property <FileRow> item;
    // Search results show a stretching location column instead of the fixed type column.
    in property <bool> wide-kind;
    in property <bool> selected;
    in property <bool> odd;
    callback select();
    callback open();
    height: 22px;
    background: selected ? Palette.selection-background : area.has-hover ? Palette.alternate-background : odd ? Palette.alternate-background.with-alpha(0.35) : transparent;
    area := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.open(); }
    }
    // Mod status stripe (added/new green, changed orange, removed red).
    Rectangle {
        x: 0;
        width: 3px;
        background: item.mark-color;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;
        Badge {
            y: (parent.height - self.height) / 2;
            text: item.badge;
            tint: item.tint;
        }
        Text {
            text: item.name;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 80px;
            preferred-width: 100px;
            max-width: 100000px;
            color: selected ? Palette.selection-foreground : Palette.foreground;
        }
        Rectangle {
            // Fixed 90px type column, or a stretching location column for search results.
            horizontal-stretch: root.wide-kind ? 2 : 0;
            min-width: root.wide-kind ? 60px : 90px;
            preferred-width: 90px;
            max-width: root.wide-kind ? 100000px : 90px;
            Text {
                width: 100%;
                text: item.kind;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                color: selected ? Palette.selection-foreground : root.wide-kind ? Palette.foreground.with-alpha(0.75) : Palette.foreground;
            }
        }
        Text {
            width: 80px;
            text: item.size;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: selected ? Palette.selection-foreground : Palette.foreground;
        }
        Text {
            width: 90px;
            text: item.info;
            vertical-alignment: center;
            overflow: elide;
            color: selected ? Palette.selection-foreground : Palette.foreground.with-alpha(0.7);
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    in property <TextHorizontalAlignment> align: left;
    callback clicked();
    TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        width: 100%;
        text: root.label + (root.active ? (root.descending ? " ▾" : " ▴") : "");
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        color: Palette.foreground;
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("icon.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 800px;
    min-height: 480px;
    background: Palette.background;

    in property <string> window-title: "OpenRAGE";
    // Resolved at startup; Slint does not map the generic "monospace" family everywhere.
    in property <string> mono-font: "monospace";

    // Navigation
    in-out property <string> address;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;

    // Tree
    in property <[TreeRow]> tree;
    in property <int> tree-selected: -1;

    // File list
    in property <[FileRow]> files;
    in property <int> file-selected: -1;
    in property <int> sort-column: 0;
    in property <bool> sort-descending: false;
    in property <int> total-count;
    in-out property <string> filter;

    // Search
    in property <bool> search-mode;
    in property <bool> show-language: true;
    in property <bool> mods-available;
    in-out property <bool> mods-overlay;
    in property <string> search-summary;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <string> index-status;

    // Preview
    in property <string> info-text;
    in property <string> preview-text;
    in property <image> preview-image;
    in property <bool> has-image;
    in property <bool> texture-mode;
    // Editing archives (written into the mods folder)
    in property <bool> archive-mode;
    in property <bool> entry-selected;
    in property <bool> can-undo;
    in property <string> undo-label;
    // Text prompt (rename, new folder)
    in-out property <bool> prompt-visible;
    in property <string> prompt-title;
    in-out property <string> prompt-value;
    in property <bool> texture-selected;
    in property <bool> preview-loading;

    // Status / background task
    in property <string> status;
    in property <bool> busy;
    in property <bool> can-extract;

    // Setup overlay
    in-out property <bool> setup-visible;
    in-out property <string> setup-game-dir;
    in-out property <string> setup-magic-path;
    in property <[string]> setup-detected;
    in property <string> setup-log;
    in property <bool> setup-running;
    in property <bool> setup-can-cancel;

    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback tree-toggle(int);
    callback tree-activate(int);
    callback file-select(int);
    callback file-open(int);
    callback sort-by(int);
    callback filter-edited(string);
    callback search(string);
    callback overlay-toggled(bool);
    callback show-changes();
    callback language-picked(int);
    callback extract-selected();
    callback save-png();
    callback archive-import();
    callback archive-replace();
    callback archive-rename();
    callback archive-new-folder();
    callback archive-delete();
    callback files-dropped(data-transfer);
    callback undo();
    callback prompt-accepted(string);
    callback texture-replace();
    callback texture-add();
    callback texture-remove();
    callback cancel-task();
    callback open-setup();
    callback setup-browse-game();
    callback setup-browse-magic();
    callback setup-pick-detected(string);
    callback setup-run();

    property <length> tree-width: 240px;
    property <length> preview-width: 480px;

    VerticalLayout {
        // Toolbar
        HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Button {
                text: "◀";
                enabled: root.can-back;
                clicked => { root.go-back(); }
            }
            Button {
                text: "▶";
                enabled: root.can-forward;
                clicked => { root.go-forward(); }
            }
            Button {
                text: "▲";
                enabled: root.can-up;
                clicked => { root.go-up(); }
            }
            address-edit := LineEdit {
                horizontal-stretch: 1;
                text <=> root.address;
                placeholder-text: @tr("Path, e.g. x64e.rpf/levels/gta5/vehicles.rpf");
                accepted(text) => { root.navigate(text); }
            }
            LineEdit {
                width: 260px;
                placeholder-text: @tr("Search names, hashes, text…");
                accepted(text) => { root.search(text); }
            }
            LineEdit {
                width: 160px;
                text <=> root.filter;
                placeholder-text: @tr("Filter list");
                edited(text) => { root.filter-edited(text); }
            }
            if root.mods-available: Button {
                text: @tr("Mods");
                checkable: true;
                checked <=> root.mods-overlay;
                clicked => { root.overlay-toggled(self.checked); }
            }
            if root.mods-available: Button {
                text: @tr("Changes");
                clicked => { root.show-changes(); }
            }
            if root.can-undo: Button {
                text: @tr("Undo");
                enabled: !root.busy;
                clicked => { root.undo(); }
            }
            Button {
                text: @tr("Extract…");
                enabled: root.can-extract && !root.busy;
                clicked => { root.extract-selected(); }
            }

            Button {
                text: @tr("Setup");
                clicked => { root.open-setup(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // Folder tree
            Rectangle {
                width: root.tree-width;
                ListView {
                    for row[i] in root.tree: TreeItem {
                        item: row;
                        selected: i == root.tree-selected;
                        toggle => { root.tree-toggle(i); }
                        activate => { root.tree-activate(i); }
                    }
                }
            }

            Splitter {
                dragged(d) => { root.tree-width = max(160px, min(root.width / 2, root.tree-width + d)); }
            }

            // File list
            VerticalLayout {
                horizontal-stretch: 1;
                if root.archive-mode: HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Changes go to the mods folder, like OpenIV — drop files here to import.");
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground.with-alpha(0.8);
                    }
                    Button {
                        text: @tr("Import…");
                        enabled: !root.busy;
                        clicked => { root.archive-import(); }
                    }
                    Button {
                        text: @tr("Replace…");
                        enabled: root.entry-selected && !root.busy;
                        clicked => { root.archive-replace(); }
                    }
                    Button {
                        text: @tr("Rename…");
                        enabled: root.entry-selected && !root.busy;
                        clicked => { root.archive-rename(); }
                    }
                    Button {
                        text: @tr("New folder…");
                        enabled: !root.busy;
                        clicked => { root.archive-new-folder(); }
                    }
                    Button {
                        text: @tr("Delete");
                        enabled: root.entry-selected && !root.busy;
                        clicked => { root.archive-delete(); }
                    }
                }
                if root.texture-mode: HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Texture dictionary — changes are written to the mods folder, like OpenIV.");
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground.with-alpha(0.8);
                    }
                    Button {
                        text: @tr("Replace…");
                        enabled: root.texture-selected && !root.busy;
                        clicked => { root.texture-replace(); }
                    }
                    Button {
                        text: @tr("Add…");
                        enabled: !root.busy;
                        clicked => { root.texture-add(); }
                    }
                    Button {
                        text: @tr("Remove");
                        enabled: root.texture-selected && !root.busy;
                        clicked => { root.texture-remove(); }
                    }
                    Button {
                        text: @tr("Save PNG…");
                        enabled: !root.busy;
                        clicked => { root.save-png(); }
                    }
                }
                if root.search-mode: HorizontalLayout {
                    padding: 6px;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.search-summary;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                    if root.show-language: ComboBox {
                        width: 170px;
                        model: root.languages;
                        current-index <=> root.language-index;
                        selected => { root.language-picked(self.current-index); }
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    padding-left: 6px + 34px + 8px;
                    padding-right: 6px;
                    spacing: 8px;
                    HeaderCell {
                        horizontal-stretch: 1;
                        min-width: 80px;
                        preferred-width: 100px;
                        label: @tr("Name");
                        active: root.sort-column == 0;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(0); }
                    }
                    HeaderCell {
                        horizontal-stretch: root.search-mode ? 2 : 0;
                        min-width: root.search-mode ? 60px : 90px;
                        preferred-width: 90px;
                        max-width: root.search-mode ? 100000px : 90px;
                        label: root.search-mode ? @tr("Location") : @tr("Type");
                        active: !root.search-mode && root.sort-column == 1;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(1); }
                    }
                    HeaderCell {
                        width: 80px;
                        align: right;
                        label: @tr("Size");
                        active: root.sort-column == 2;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(2); }
                    }
                    HeaderCell {
                        width: 90px;
                        label: @tr("Info");
                        active: root.sort-column == 3;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(3); }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-width: drop.has-drag ? 2px : 0px;
                    border-color: Palette.accent-background;
                    drop := DropArea {
                        enabled: root.archive-mode && !root.busy;
                        can-drop(event) => { return DragAction.copy; }
                        dropped(event) => {
                            root.files-dropped(event.data);
                            return DragAction.copy;
                        }
                    }
                    ListView {
                    for row[i] in root.files: FileItem {
                        item: row;
                        wide-kind: root.search-mode;
                        odd: Math.mod(i, 2) == 1;
                        selected: i == root.file-selected;
                        select => { root.file-select(i); }
                        open => { root.file-open(i); }
                    }
                }
                }
            }

            Splitter {
                dragged(d) => { root.preview-width = max(240px, min(root.width / 2, root.preview-width - d)); }
            }

            // Info + preview
            VerticalLayout {
                width: root.preview-width;
                padding: 6px;
                spacing: 6px;
                Text {
                    text: root.info-text;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.alternate-background;
                    if root.has-image: Image {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        source: root.preview-image;
                        image-fit: contain;
                        image-rendering: smooth;
                    }
                    if !root.has-image: ScrollView {
                        content-width: max(self.visible-width, preview.preferred-width + 16px);
                        content-height: max(self.visible-height, preview.preferred-height + 16px);
                        preview := Text {
                            x: 8px;
                            y: 8px;
                            text: root.preview-text;
                            font-family: root.mono-font;
                            font-size: 12px;
                            wrap: no-wrap;
                            color: Palette.foreground;
                        }
                    }
                    if root.preview-loading: Spinner {
                        width: 32px;
                        height: 32px;
                        indeterminate: true;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        // Status bar
        HorizontalLayout {
            padding: 4px;
            padding-left: 8px;
            spacing: 8px;
            height: 28px;
            Text {
                text: root.filter == "" ? @tr("{} items", root.total-count) : @tr("{} of {} items", root.files.length, root.total-count);
                vertical-alignment: center;
                color: Palette.foreground;
            }
            Text {
                horizontal-stretch: 1;
                text: root.status;
                vertical-alignment: center;
                overflow: elide;
                color: Palette.foreground.with-alpha(0.8);
            }
            Text {
                text: root.index-status;
                vertical-alignment: center;
                color: Palette.foreground.with-alpha(0.7);
            }
            if root.busy: Spinner {
                width: 18px;
                indeterminate: true;
            }
            if root.busy: Button {
                text: @tr("Cancel");
                clicked => { root.cancel-task(); }
            }
        }
    }

    // Text prompt (rename, new folder)
    if root.prompt-visible: Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: min(460px, root.width - 40px);
            height: 150px;
            border-radius: 8px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.prompt-title;
                    font-weight: 700;
                    color: Palette.foreground;
                }
                prompt-edit := LineEdit {
                    text <=> root.prompt-value;
                    accepted(text) => { root.prompt-accepted(text); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.prompt-visible = false; }
                    }
                    Button {
                        text: @tr("OK");
                        primary: true;
                        enabled: root.prompt-value != "";
                        clicked => { root.prompt-accepted(root.prompt-value); }
                    }
                }
            }
        }
        init => { prompt-edit.focus(); }
    }

    // First-run / key setup overlay
    if root.setup-visible: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(640px, root.width - 40px);
            height: min(460px, root.height - 40px);
            border-radius: 8px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: @tr("Set up OpenRAGE");
                    font-size: 18px;
                    font-weight: 700;
                    color: Palette.foreground;
                }
                Text {
                    text: @tr("OpenRAGE reads the archive keys from your own copy of GTA V. No keys or game files are included with OpenRAGE.");
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                if root.setup-detected.length > 0: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: @tr("Detected:");
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.setup-detected;
                        selected(value) => { root.setup-pick-detected(value); }
                    }
                }
                Text {
                    text: @tr("Game directory");
                    font-weight: 600;
                    color: Palette.foreground;
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.setup-game-dir;
                        placeholder-text: @tr("Folder containing GTA5_Enhanced.exe or GTA5.exe");
                    }
                    Button {
                        text: @tr("Browse…");
                        clicked => { root.setup-browse-game(); }
                    }
                }
                Text {
                    text: @tr("Key blob (only needed for GTA V Enhanced)");
                    font-weight: 600;
                    color: Palette.foreground;
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.setup-magic-path;
                        placeholder-text: @tr("Path to magic.dat");
                    }
                    Button {
                        text: @tr("Browse…");
                        clicked => { root.setup-browse-magic(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.alternate-background;
                    border-radius: 4px;
                    Text {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        text: root.setup-log;
                        wrap: word-wrap;
                        font-family: root.mono-font;
                        font-size: 12px;
                        color: Palette.foreground;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    if root.setup-running: Spinner {
                        width: 24px;
                        indeterminate: true;
                    }
                    if root.setup-can-cancel: Button {
                        text: @tr("Close");
                        enabled: !root.setup-running;
                        clicked => { root.setup-visible = false; }
                    }
                    Button {
                        text: @tr("Derive keys");
                        primary: true;
                        enabled: !root.setup-running && root.setup-game-dir != "";
                        clicked => { root.setup-run(); }
                    }
                }
            }
        }
    }
}
