// OpenRAGE main window.
// All user-visible strings go through @tr() so the UI can be translated.
// Spacing, sizes and colors come from the Theme tokens (theme.slint).

import { Button, CheckBox, LineEdit, ComboBox, ScrollView, ListView, Palette, Slider, Spinner, TabWidget, TextEdit } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
export { Theme }

export struct TreeRow {
    name: string,
    path: string,
    depth: int,
    expandable: bool,
    expanded: bool,
    icon: string,
    tint: color,
}

export struct XmlNodeRow {
    id: int,
    label: string,
    depth: int,
    expandable: bool,
    expanded: bool,
    // Matches the filter (shown in bold while filtering).
    hit: bool,
}

export struct XmlSpan {
    text: string,
    // 0 punctuation, 1 tag, 2 attribute, 3 value, 4 text
    kind: int,
}

export struct CastRow {
    kind: string,
    name: string,
    // Has a model and an animation to play.
    playable: bool,
}

export struct XmlLine {
    number: int,
    spans: [XmlSpan],
}

// A game that has been set up, for the game switcher.
export struct GameRow {
    name: string,
    path: string,
    is-default: bool,
    is-current: bool,
}

export struct InfoRow {
    // Empty key: a note spanning the whole row.
    key: string,
    value: string,
}

// A value in an info table: selectable and copyable (Ctrl+C), and wrapped
// anywhere so long names without spaces stay inside the table.
component InfoValue inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: char-wrap;
    selection-background-color: Theme.accent.with-alpha(0.35);
    selection-foreground-color: self.color;
}

// A third-party crate in the About dialog.
export struct DepRow {
    name: string,
    version: string,
    license: string,
}

export struct PartRow {
    name: string,
    visible: bool,
    // 0: group or single part, 1: part inside a group.
    level: int,
    // Number of parts in a group (0 for a part row).
    count: int,
}

export struct MaterialRow {
    label: string,
    visible: bool,
    color: color,
    paint: bool,
    textured: bool,
}

export struct HistoryRow {
    when: string,
    description: string,
    place: string,
    group: string,
}

// One axis of the orientation compass: screen direction (-1..1) and
// whether it points away from the viewer.
export struct GizmoAxis {
    dx: float,
    dy: float,
    away: bool,
}

export struct ClipRow {
    name: string,
    // Length, e.g. "2.1 s".
    info: string,
}

export struct Crumb {
    label: string,
    path: string,
}

// An installed plugin on the settings page.
export struct PluginRow {
    id: string,
    title: string,
    description: string,
    status: string,
    permissions: string,
    enabled: bool,
    // The folder could not be loaded (`permissions` holds the reason).
    broken: bool,
    // Installed into the user's plugin folder (can be uninstalled here).
    removable: bool,
}

export struct FileRow {
    // Mod status: 0 none, 1 added/new, 2 changed, 3 contains mods, 4 removed.
    mark: int,
    dim: bool,
    name: string,
    icon: string,
    tint: color,
    kind: string,
    size: string,
    info: string,
    // Double-click navigates into it (folder, archive, texture dictionary, search hit).
    can-open: bool,
    // Has a 3D or image view (model, texture).
    can-view: bool,
    is-model: bool,
    // A text file (opens in the text editor).
    can-edit-text: bool,
    // Binary metadata (.ymap, .ytyp, .ymt, …) shown as XML.
    is-meta: bool,
    // Text table (.gxt2, .nametable) edited as text.
    is-table: bool,
    // Scaleform movie (.gfx): exportable as .swf.
    is-gfx: bool,
    // Context-menu entries added by plugins.
    plugin-actions: [string],
}

component FormatIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint;
    // A file that holds other files (opens like a folder): marked with a badge.
    in property <bool> container;
    width: Theme.icon-size;
    height: Theme.icon-size;
    Image {
        width: 100%;
        height: 100%;
        source: Icons.get(root.name);
        colorize: root.tint;
        image-rendering: smooth;
    }
    if root.container: Rectangle {
        x: parent.width - self.width + 3px;
        y: parent.height - self.height + 3px;
        width: 10px;
        height: 10px;
        border-radius: 3px;
        background: root.tint;
        border-width: 1.5px;
        border-color: Theme.background;
        // Three stacked lines: "contains items".
        for i in 3: Rectangle {
            x: 2.5px;
            y: 2.5px + i * 2px;
            width: 5px;
            height: 1px;
            background: Theme.background;
        }
    }
}

// Flat icon button for the toolbar.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <color> tint: Theme.text;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-subtle : (ta.has-hover && root.enabled ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    Image {
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.enabled ? root.tint : Theme.text-faint;
        image-rendering: smooth;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Tooltip {
        text: @markdown("\{root.label}");
    }
}

// A vertical divider for toolbars: fills the row's height (layouts override
// `y`), with a 20px line centered in it.
component VSeparator inherits Rectangle {
    width: 1px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: min(20px, parent.height);
        background: Theme.border;
    }
}

component Splitter inherits Rectangle {
    callback dragged(length);
    width: 5px;
    background: ta.has-hover || ta.pressed ? Theme.accent : transparent;
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        background: Theme.border;
    }
    ta := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

component TreeItem inherits Rectangle {
    in property <TreeRow> item;
    in property <bool> selected;
    callback toggle();
    callback activate();
    callback action(string);
    height: Theme.row-height;
    border-radius: Theme.radius-s;
    background: selected ? Theme.selection : area.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: item.name;
    area := TouchArea {
        clicked => { root.activate(); }
        double-clicked => { root.toggle(); }
    }
    HorizontalLayout {
        padding-left: Theme.space-xs + item.depth * 14px;
        padding-right: Theme.space-s;
        spacing: Theme.space-xs;
        Rectangle {
            width: 16px;
            Text {
                text: item.expandable ? (item.expanded ? "▾" : "▸") : "";
                color: selected ? Theme.selection-text : Theme.text-muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                clicked => { root.toggle(); }
            }
        }
        FormatIcon {
            y: (parent.height - self.height) / 2;
            name: item.icon;
            // On the filled selection the type color would clash with the accent.
            tint: selected ? Theme.selection-text : item.tint;
        }
        Text {
            text: item.name;
            vertical-alignment: center;
            overflow: elide;
            color: selected ? Theme.selection-text : Theme.text;
        }
    }
    // Last, so it is on top: a TouchArea inside would take the right click too.
    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Open");
                icon: @image-url("icons/menu/open.svg");
                activated => { root.activate(); }
            }
            if item.expandable: MenuItem {
                title: item.expanded ? @tr("Collapse") : @tr("Expand");
                icon: @image-url("icons/menu/chevrons.svg");
                activated => { root.toggle(); }
            }
            MenuItem {
                title: @tr("Extract…");
                icon: @image-url("icons/menu/extract.svg");
                activated => { root.action("extract"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy path");
                icon: @image-url("icons/menu/copy.svg");
                activated => { root.action("copy-path"); }
            }
        }
    }
}

component FileItem inherits Rectangle {
    in property <FileRow> item;
    // Search results show a location column instead of the type column.
    in property <bool> wide-kind;
    // Column widths, set by dragging the header's dividers.
    in property <length> kind-width: 110px;
    in property <length> size-width: 72px;
    in property <length> info-width: 96px;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> odd;
    // Context of the current folder, for the context menu.
    in property <bool> archive-mode;
    in property <bool> texture-mode;
    in property <bool> history-mode;
    in property <bool> can-edit;
    callback select();
    callback open();
    callback action(string);
    height: Theme.row-height;
    opacity: item.dim ? 0.55 : 1.0;
    property <color> fg: selected && focused ? Theme.selection-text : Theme.text;
    background: selected ? (focused ? Theme.selection : Theme.accent-subtle) : area.has-hover ? Theme.hover : odd ? Theme.stripe : transparent;
    accessible-role: list-item;
    accessible-label: item.name + ", " + item.kind;
    accessible-item-selected: root.selected;

    area := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.open(); }
    }
    // Mod status stripe (added/new green, changed orange, has mods blue, removed red).
    Rectangle {
        x: 0;
        width: 3px;
        background: Theme.mark-color(item.mark);
    }
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        FormatIcon {
            y: (parent.height - self.height) / 2;
            name: item.icon;
            tint: selected && focused ? Theme.selection-text : item.tint;
            container: item.can-open && item.icon != "folder" && item.icon != "archive";
            Tooltip {
                text: @markdown("\{item.can-open && item.icon != "folder" && item.icon != "archive" ? @tr("Contains files — double-click to open") : item.kind}");
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            preferred-width: 100px;
            max-width: 100000px;
            spacing: Theme.space-xs;
            Text {
                horizontal-stretch: 1;
                text: item.name;
                vertical-alignment: center;
                overflow: elide;
                color: root.fg;
            }
        }
        Rectangle {
            // Type column, or the location column for search results.
            width: root.kind-width;
            Text {
                width: 100%;
                text: item.kind;
                vertical-alignment: center;
                overflow: elide;
                color: selected && focused ? Theme.selection-text : Theme.text-muted;
            }
        }
        Text {
            width: root.size-width;
            text: item.size;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: root.fg;
        }
        Text {
            width: root.info-width;
            text: item.info;
            vertical-alignment: center;
            overflow: elide;
            color: selected && focused ? Theme.selection-text : Theme.text-muted;
        }
    }
    // Last, so it is on top: a TouchArea inside would take the right click too.
    ContextMenuArea {
        Menu {
            if item.can-open: MenuItem {
                title: @tr("Open");
                icon: @image-url("icons/menu/open.svg");
                activated => { root.action("open"); }
            }
            if item.can-view: MenuItem {
                title: @tr("Open in viewer");
                icon: @image-url("icons/menu/expand.svg");
                activated => { root.action("view"); }
            }
            if item.can-edit-text: MenuItem {
                title: @tr("Open in text editor");
                icon: @image-url("icons/menu/text.svg");
                activated => { root.action("edit"); }
            }
            if item.is-meta: MenuItem {
                title: @tr("Show as XML");
                icon: @image-url("icons/menu/text.svg");
                activated => { root.action("xml-view"); }
            }
            if item.is-gfx: MenuItem {
                title: @tr("Export as SWF…");
                icon: @image-url("icons/menu/export.svg");
                activated => { root.action("swf"); }
            }
            if item.is-table: MenuItem {
                title: @tr("Export as text…");
                icon: @image-url("icons/menu/export.svg");
                activated => { root.action("text-export"); }
            }
            if item.is-meta: MenuItem {
                title: @tr("Export XML…");
                icon: @image-url("icons/menu/export.svg");
                activated => { root.action("xml"); }
            }
            if item.plugin-actions.length > 0: MenuSeparator {}
            for title[i] in item.plugin-actions: MenuItem {
                title: title;
                icon: @image-url("icons/menu/export.svg");
                activated => { root.action("plugin:" + i); }
            }
            if !root.history-mode && item.kind != "Folder": MenuItem {
                title: @tr("Open with system app (read-only copy)");
                icon: @image-url("icons/menu/export.svg");
                activated => { root.action("system"); }
            }
            if !root.history-mode: MenuItem {
                title: @tr("Extract…");
                icon: @image-url("icons/menu/extract.svg");
                activated => { root.action("extract"); }
            }
            if item.is-model: MenuItem {
                title: @tr("Export glTF…");
                icon: @image-url("icons/menu/export.svg");
                activated => { root.action("gltf"); }
            }
            if root.texture-mode: MenuItem {
                title: @tr("Save PNG…");
                icon: @image-url("icons/menu/image.svg");
                activated => { root.action("png"); }
            }
            if root.archive-mode || root.texture-mode: MenuSeparator { }
            if root.archive-mode || root.texture-mode: MenuItem {
                title: @tr("Replace…");
                icon: @image-url("icons/menu/replace.svg");
                enabled: root.can-edit;
                activated => { root.action("replace"); }
            }
            if root.archive-mode: MenuItem {
                title: @tr("Rename…");
                icon: @image-url("icons/menu/rename.svg");
                enabled: root.can-edit;
                activated => { root.action("rename"); }
            }
            if root.archive-mode || root.texture-mode: MenuItem {
                title: root.texture-mode ? @tr("Remove") : @tr("Delete");
                icon: @image-url("icons/menu/trash.svg");
                enabled: root.can-edit;
                activated => { root.action("delete"); }
            }
            if root.history-mode: MenuItem {
                title: @tr("Uninstall package");
                icon: @image-url("icons/menu/trash.svg");
                enabled: root.can-edit;
                activated => { root.action("uninstall"); }
            }
            MenuSeparator { }
            if root.wide-kind: MenuItem {
                title: @tr("Show in folder");
                icon: @image-url("icons/menu/folder.svg");
                activated => { root.action("show-in-folder"); }
            }
            if !root.history-mode: MenuItem {
                title: @tr("Search for this name");
                icon: @image-url("icons/menu/search.svg");
                activated => { root.action("search-name"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy name");
                icon: @image-url("icons/menu/copy.svg");
                activated => { root.action("copy-name"); }
            }
            MenuItem {
                title: @tr("Copy path");
                icon: @image-url("icons/menu/copy.svg");
                activated => { root.action("copy-path"); }
            }
            if !root.history-mode: MenuItem {
                title: @tr("Copy hash");
                icon: @image-url("icons/menu/copy.svg");
                activated => { root.action("copy-hash"); }
            }
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    in property <TextHorizontalAlignment> align: left;
    // A divider on the left edge widens (drag left) or narrows the column.
    in property <bool> resizable;
    callback clicked();
    callback resized(length);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    // Inside the cell: Slint only delivers pointer events within the parent.
    if root.resizable: Rectangle {
        x: 0;
        width: 6px;
        background: grip.has-hover || grip.pressed ? Theme.accent : transparent;
        Rectangle {
            x: 0;
            y: 4px;
            width: 1px;
            height: parent.height - 8px;
            background: Theme.border;
        }
        grip := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if (self.pressed) {
                    root.resized(self.pressed-x - self.mouse-x);
                }
            }
        }
    }
    Text {
        width: 100%;
        text: root.label + (root.active ? (root.descending ? " ▾" : " ▴") : "");
        font-size: Theme.font-small;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        color: ta.has-hover || root.active ? Theme.text : Theme.text-muted;
    }
}

// Tinted bar above the file list explaining the current context and its actions.
component ContextBar inherits Rectangle {
    in property <string> title;
    in property <string> description;
    background: Theme.accent-subtle;
    border-radius: Theme.radius;
    HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-m;
        spacing: Theme.space-s;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-weight: 600;
                overflow: elide;
                color: Theme.text;
            }
            if root.description != "": Text {
                text: root.description;
                font-size: Theme.font-small;
                overflow: elide;
                color: Theme.text-muted;
            }
        }
        @children
    }
}

// Orientation compass: the game's X (red), Y (green) and Z (blue, up) axes
// as seen by the camera. Clicking a letter looks along that axis.
component AxisGizmo inherits Rectangle {
    in property <[GizmoAxis]> axes;
    callback pick(int);
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background: Theme.background.with-alpha(0.55);
    property <[color]> colors: [#e5484d, #30a46c, #3e7bf6];
    property <[string]> names: ["X", "Y", "Z"];
    for a[i] in root.axes: Path {
        width: root.width;
        height: root.height;
        viewbox-x: -1;
        viewbox-y: -1;
        viewbox-width: 2;
        viewbox-height: 2;
        stroke: root.colors[i].with-alpha(a.away ? 0.45 : 1.0);
        stroke-width: a.away ? 1.5px : 2.5px;
        commands: "M 0 0 L " + (a.dx * 0.62) + " " + (a.dy * 0.62);
    }
    for a[i] in root.axes: Rectangle {
        x: root.width / 2 + a.dx * 0.62 * root.width / 2 - self.width / 2;
        y: root.height / 2 + a.dy * 0.62 * root.height / 2 - self.height / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.colors[i].with-alpha(a.away ? 0.5 : 1.0);
        Text {
            text: root.names[i];
            font-size: 10px;
            font-weight: 700;
            color: white;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(i); }
        }
    }
}

// Drag to orbit, wheel to zoom.
component ModelControls inherits TouchArea {
    callback orbit(length, length);
    callback zoom(float);
    callback pressed-down();
    property <length> last-x;
    property <length> last-y;
    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            self.last-x = self.mouse-x;
            self.last-y = self.mouse-y;
            root.pressed-down();
        }
    }
    moved => {
        if (self.pressed) {
            root.orbit(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
            self.last-x = self.mouse-x;
            self.last-y = self.mouse-y;
        }
    }
    scroll-event(e) => {
        root.zoom(e.delta-y / 1px);
        return EventResult.accept;
    }
}

// Modal dialog: dims the window, closes with Escape (when closable).
component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> panel-width: 520px;
    in property <length> panel-height: 400px;
    in property <bool> closable: true;
    callback close();
    background: Theme.scrim;
    TouchArea { }
    scope := FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            enabled: root.closable;
            activated => { root.close(); }
        }
        Rectangle {
            width: min(root.panel-width, root.width - 48px);
            height: min(root.panel-height, root.height - 48px);
            border-radius: 10px;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            accessible-role: groupbox;
            accessible-label: root.title;
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;
                HorizontalLayout {
                    spacing: Theme.space-s;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-xs;
                        Text {
                            text: root.title;
                            font-size: Theme.font-heading;
                            font-weight: 700;
                            overflow: elide;
                            color: Theme.text;
                        }
                        if root.subtitle != "": Text {
                            text: root.subtitle;
                            overflow: elide;
                            color: Theme.text-muted;
                        }
                    }
                    if root.closable: IconButton {
                        icon: @image-url("icons/close.svg");
                        label: @tr("Close");
                        clicked => { root.close(); }
                    }
                }
                @children
            }
        }
    }
    init => { scope.focus(); }
}

// Asks before unlocking edit mode (used by the main window and editor windows).
component UnlockDialog {
    /// The folder changes go to: `mods`, or `update` for GTA IV.
    in property <string> folder: "mods";
    /// GTA IV: whether changes may go into the game's own files instead.
    in property <bool> can-choose;
    /// Changes go into the game's own files (originals kept).
    in property <bool> in-game;
    callback choose(bool);
    callback confirm();
    callback cancel();
    Dialog {
        width: root.width;
        height: root.height;
        title: @tr("Unlock editing?");
        panel-width: 540px;
        panel-height: root.can-choose ? 395px : 360px;
        close => { root.cancel(); }
        Text {
            wrap: word-wrap;
            color: Theme.text;
            text: @tr("Edit mode lets OpenRAGE change archives, textures and text files, and install packages.");
        }
        Rectangle {
            border-radius: Theme.radius;
            background: Theme.warning.with-alpha(0.14);
            border-width: 1px;
            border-color: Theme.warning.with-alpha(0.5);
            HorizontalLayout {
                padding: Theme.space-m;
                spacing: Theme.space-m;
                Image {
                    y: Theme.space-xs;
                    width: 22px;
                    height: 22px;
                    source: @image-url("icons/warning.svg");
                    colorize: Theme.warning;
                }
                VerticalLayout {
                    spacing: Theme.space-xs;
                    Text {
                        text: @tr("Do not play online with modified files.");
                        font-weight: 700;
                        wrap: word-wrap;
                        color: Theme.warning;
                    }
                    Text {
                        text: @tr("Rockstar can ban accounts that join GTA Online with changed game files. Use mods only in story mode.");
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                }
            }
        }
        VerticalLayout {
            spacing: Theme.space-xs;
            Text {
                wrap: word-wrap;
                color: Theme.text-muted;
                text: root.in-game
                    ? @tr("• Changes go into the game's own files. The original of each file is kept first and can be put back from History.")
                    : @tr("• Game files are never changed: an archive is copied to the {} folder before its first change.", root.folder);
            }
            Text {
                wrap: word-wrap;
                color: Theme.text-muted;
                text: @tr("• Every change is recorded in History and can be undone.");
            }
            if root.can-choose: CheckBox {
                text: @tr("Write directly into the game files (instead of the {} folder)", root.folder);
                checked: root.in-game;
                toggled => { root.choose(self.checked); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-s;
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                text: @tr("Unlock editing");
                icon: @image-url("icons/unlock.svg");
                colorize-icon: true;
                primary: true;
                clicked => { root.confirm(); }
            }
        }
    }
}

// Shown while edit mode is on, with a way to lock again.
component EditModeStrip inherits Rectangle {
    in property <string> folder: "mods";
    in property <bool> in-game;
    callback lock();
    background: Theme.warning.with-alpha(0.16);
    HorizontalLayout {
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        padding-left: Theme.space-l;
        padding-right: Theme.space-m;
        spacing: Theme.space-s;
        Image {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("icons/warning.svg");
            colorize: Theme.warning;
        }
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.text;
            text: root.in-game
                ? @tr("Edit mode is on — changes are written into the game files (originals kept). Lock it when you are done.")
                : @tr("Edit mode is on — changes are written to the {} folder. Lock it when you are done.", root.folder);
        }
        Button {
            text: @tr("Lock editing");
            icon: @image-url("icons/lock.svg");
            colorize-icon: true;
            clicked => { root.lock(); }
        }
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("logo.svg");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 520px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    in property <string> window-title: "OpenRAGE";
    // Resolved at startup; Slint does not map the generic "monospace" family everywhere.
    in property <string> mono-font: "monospace";
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme-mode;

    // Navigation
    in-out property <string> address;
    in property <[Crumb]> crumbs;
    in-out property <bool> address-editing;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    in property <string> location-title;

    // Tree
    in property <[TreeRow]> tree;
    in property <int> tree-selected: -1;

    // File list
    in property <[FileRow]> files;
    in property <int> file-selected: -1;
    in property <int> sort-column: 0;
    in property <bool> sort-descending: false;
    in property <int> total-count;
    in-out property <string> filter;

    // Search
    in property <bool> search-mode;
    in property <bool> show-language: true;
    in property <bool> mods-available;
    in-out property <bool> mods-overlay;
    in property <string> search-summary;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <string> index-status;

    // Info + preview
    in property <string> info-title;
    in property <string> info-path;
    in property <[InfoRow]> info-rows;
    in property <string> info-icon: "folder";
    in property <color> info-tint: #b8902a;
    in property <string> preview-text;
    in property <image> preview-image;
    in property <bool> has-image;
    // Model preview: drag to orbit, wheel to zoom.
    in property <bool> model-mode;
    in property <[GizmoAxis]> gizmo;
    // Models suggested for the selected clip dictionary.
    in property <[ClipRow]> suggestions;
    in property <string> suggest-title;
    // A background search for suggestions (e.g. models for an animation) is running.
    in property <bool> suggest-pending;
    // Icon of the rows: "model" for suggested models, "audio" for a container's sounds.
    in property <string> suggest-icon: "model";
    // Sound preview: waveform in the preview area, player controls above it.
    in property <bool> audio-mode;
    // The preview image is a texture or picture (not a waveform), so it can open in the viewer.
    in property <bool> image-viewable;
    in property <bool> audio-playing;
    in property <float> audio-position;
    in property <string> audio-time;
    in property <bool> audio-mode-folder;
    in property <bool> audio-has-prev;
    in property <bool> audio-has-next;
    in-out property <bool> audio-play-all;
    out property <length> preview-area-width;
    out property <length> preview-area-height;
    in property <bool> texture-mode;
    // Editing archives (written into the mods folder)
    in property <bool> archive-mode;
    // Edit mode (like OpenIV): changes are only possible after unlocking.
    in-out property <bool> edit-mode;
    /// The folder changes go to: `mods`, or `update` for GTA IV.
    in property <string> overlay-folder: "mods";
    /// Changes go into the game's own files (GTA IV, when chosen).
    in property <bool> write-in-game;
    /// GTA IV: the unlock dialog offers writing into the game's own files.
    in property <bool> can-write-in-game;
    callback write-target-changed(bool);
    in-out property <bool> unlock-visible;
    // The current archive or folder comes from the mods folder.
    in property <bool> in-mods;
    in property <bool> entry-selected;
    in property <bool> can-undo;
    in property <string> undo-label;
    // OpenIV package dialog
    in-out property <bool> oiv-visible;
    in property <string> oiv-title;
    in property <string> oiv-subtitle;
    in property <string> oiv-description;
    in property <string> oiv-changes;
    in property <string> oiv-problems;
    in property <bool> oiv-can-install;
    in property <bool> oiv-running;
    // Journal / history view
    in property <bool> history-mode;
    in property <string> history-group;
    // Text prompt (rename, new folder)
    in-out property <bool> prompt-visible;
    in property <string> prompt-title;
    in-out property <string> prompt-value;
    in property <bool> texture-selected;
    in property <bool> preview-loading;
    // Progress of the preview's load: 0..1, or below 0 when unknown; and the current step.
    in property <float> preview-progress: -1;
    in property <string> preview-progress-text;
    in-out property <bool> shortcuts-visible;
    // About dialog: version, licence notice, credits (NOTICE.md sections:
    // key = title, value = text) and the third-party crates.
    in-out property <bool> about-visible;
    in property <string> about-version;
    in property <string> about-notice;
    in property <[InfoRow]> about-credits;
    in property <[DepRow]> about-deps;
    in property <string> about-deps-summary;
    in-out property <int> about-selected: -1;
    in property <string> about-text;
    in-out property <string> about-filter;
    in-out property <int> about-tab;
    // History opens in its own window (else in the file list).
    in-out property <bool> history-in-window: true;

    // Status / background task
    in property <string> status;
    // The last error shown; the status is highlighted while it still says that.
    in property <string> status-error;
    property <bool> status-is-error: root.status != "" && root.status == root.status-error;
    in property <bool> busy;
    // The running task stops when asked (extraction, plugin runs); others finish.
    in property <bool> cancellable;
    in property <bool> can-extract;

    // Setup overlay
    in-out property <bool> setup-visible;
    in-out property <string> setup-game-dir;
    in-out property <string> setup-magic-path;
    in property <[string]> setup-detected;
    in property <string> setup-log;
    in property <bool> setup-running;
    in property <bool> setup-can-cancel;

    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback tree-toggle(int);
    callback tree-activate(int);
    callback tree-action(int, string);
    callback file-select(int);
    callback file-open(int);
    callback row-action(int, string);
    callback sort-by(int);
    callback filter-edited(string);
    callback search(string);
    callback overlay-toggled(bool);
    callback show-changes();
    callback language-picked(int);
    callback extract-selected();
    callback save-png();
    callback model-orbit(length, length);
    callback model-zoom(float);
    callback model-axis(int);
    callback suggestion-open(int);
    callback model-resized();
    callback export-gltf();
    callback audio-toggle();
    callback audio-stop();
    callback audio-seek(float);
    callback audio-step(int);
    callback audio-skip(float);
    callback audio-save-wav();
    callback open-viewer();
    /// GTA IV: textures inside the selected model (.wdr); 0 hides the button.
    in property <int> model-textures;
    callback open-model-textures();
    callback archive-import();
    callback archive-replace();
    callback archive-rename();
    callback archive-new-folder();
    callback archive-delete();
    callback files-dropped(data-transfer);
    callback undo();
    callback install-oiv();
    callback oiv-confirm();
    callback show-history();
    callback uninstall-group();
    callback prompt-accepted(string);
    callback texture-replace();
    // Import a natives.json for script disassembly.
    callback load-natives();
    callback about-open();
    callback about-filter-edited(string);
    callback about-select(int);
    // "gpl", "agpl" or "notice": shows that text in the licences tab.
    callback about-show(string);
    callback about-open-source();
    callback texture-add();
    callback texture-remove();
    callback cancel-task();
    callback open-setup();
    callback setup-browse-game();
    callback setup-browse-magic();
    callback setup-pick-detected(string);
    callback setup-run();
    callback theme-changed(int);
    // Accent color (View → Accent color): mode 0 style, 1 orange, 2 custom color.
    callback accent-chosen(int, color);
    pure callback color-hex(color) -> string;
    // Transparent when the text is not a color.
    pure callback parse-hex(string) -> color;
    in-out property <string> accent-hex;
    // Games set up so far and the chooser shown at start or from File → Switch game….
    in property <[GameRow]> games;
    in-out property <bool> game-chooser-visible;
    in-out property <bool> game-chooser-can-cancel;
    in-out property <bool> game-remember;
    // No default game: ask at every start.
    in property <bool> ask-game: true;
    callback game-chosen(int, bool);
    callback ask-game-changed(bool);
    // Plugins on the settings page.
    in property <[PluginRow]> plugins;
    in property <string> plugin-folder;
    in property <bool> settings-scroll-end;
    callback plugin-toggled(string, bool);
    callback open-plugin-folder();
    callback reload-plugins();
    callback pick-plugin-package();
    callback uninstall-plugin(string);
    // Plugin package (.orp) waiting for the user's go-ahead.
    in-out property <bool> plugin-pkg-visible;
    in property <string> plugin-pkg-title;
    in property <string> plugin-pkg-subtitle;
    in property <string> plugin-pkg-details;
    callback plugin-pkg-confirm();
    in-out property <bool> settings-visible;
    // The configured game for the settings page: short name and folder.
    in property <string> settings-game;
    in property <string> settings-game-dir;
    callback edit-mode-changed(bool);
    callback history-window-changed(bool);
    callback quit();

    preview-area-width: preview-area.width;
    preview-area-height: preview-area.height;
    changed preview-area-width => { root.model-resized(); }
    changed preview-area-height => { root.model-resized(); }
    changed theme-mode => { root.apply-theme(); }
    changed edit-mode => { root.edit-mode-changed(root.edit-mode); }
    init => { root.apply-theme(); }

    property <length> tree-width: 260px;
    // File list columns (the name column takes the rest); resizable in the header.
    out property <length> col-kind-width: 110px;
    property <length> col-location-width: 320px;
    property <length> col-size-width: 72px;
    property <length> col-info-width: 96px;
    property <length> preview-width: 460px;
    property <bool> has-selection: root.file-selected >= 0;
    property <bool> can-view: (root.model-mode || (root.has-image && root.image-viewable)) && !root.audio-mode;
    property <bool> can-edit: root.edit-mode && !root.busy && !root.textures-locked;
    // The open texture list belongs to a particle dictionary and cannot be changed.
    in property <bool> textures-locked;
    // The open texture list is a Red Dead Redemption 2 dictionary (read-only).
    /// Game whose read-only textures are shown ("" for particle textures).
    in property <string> textures-game;

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    function toggle-edit-mode() {
        if (root.edit-mode) {
            root.edit-mode = false;
        } else {
            root.unlock-visible = true;
        }
    }

    public function open-game-chooser(can-cancel: bool) {
        root.game-chooser-can-cancel = can-cancel;
        root.game-remember = false;
        root.game-chooser-visible = true;
    }

    public function open-settings() {
        root.accent-hex = root.color-hex(Theme.accent);
        root.settings-visible = true;
    }

    function set-theme(mode: int) {
        root.theme-mode = mode;
        root.theme-changed(mode);
    }

    public function select-row(i: int) {
        root.file-select(i);
        root.reveal-row(i);
    }

    // Scrolls the file list just enough to show row `i`.
    function reveal-row(i: int) {
        if (i < 0) {
            return;
        }
        // One row of context stays visible above and below the selection.
        if (max(0, i - 1) * Theme.row-height < -list.content-y) {
            list.content-y = -max(0, i - 1) * Theme.row-height;
        } else if ((i + 2) * Theme.row-height > list.visible-height - list.content-y) {
            list.content-y = min(0, list.visible-height - min(i + 2, root.files.length) * Theme.row-height);
        }
    }

    // Selections made by the app (opening a path, Back, sorting, …) are kept in view too.
    changed file-selected => {
        root.reveal-row(root.file-selected);
    }

    function move-selection(delta: int) {
        if (root.files.length > 0) {
            root.select-row(root.file-selected < 0 ? 0 : max(0, min(root.files.length - 1, root.file-selected + delta)));
        }
    }

    function delete-selected() {
        if (!root.can-edit) {
            return;
        }
        if (root.archive-mode && root.entry-selected) {
            root.archive-delete();
        } else if (root.texture-mode && root.texture-selected) {
            root.texture-remove();
        }
    }

    function replace-selected() {
        if (!root.can-edit) {
            return;
        }
        if (root.archive-mode && root.entry-selected) {
            root.archive-replace();
        } else if (root.texture-mode && root.texture-selected) {
            root.texture-replace();
        }
    }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Install package (.oiv)…");
                icon: @image-url("icons/menu/package.svg");
                shortcut: @keys(Control + O);
                enabled: !root.busy;
                activated => { root.install-oiv(); }
            }
            MenuItem {
                title: @tr("Extract…");
                icon: @image-url("icons/menu/extract.svg");
                shortcut: @keys(Control + E);
                enabled: root.can-extract && !root.busy;
                activated => { root.extract-selected(); }
            }
            MenuItem {
                title: @tr("Export glTF…");
                icon: @image-url("icons/menu/export.svg");
                enabled: root.model-mode && !root.busy;
                activated => { root.export-gltf(); }
            }
            MenuItem {
                title: @tr("Save PNG…");
                icon: @image-url("icons/menu/image.svg");
                enabled: root.texture-mode && !root.busy;
                activated => { root.save-png(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Switch game…");
                enabled: root.games.length > 0;
                activated => { root.open-game-chooser(true); }
            }
            MenuItem {
                title: @tr("Settings…");
                icon: @image-url("icons/menu/settings.svg");
                shortcut: @keys(Control + ",");
                activated => { root.open-settings(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                activated => { root.quit(); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: root.edit-mode ? @tr("Lock editing") : @tr("Unlock editing…");
                icon: root.edit-mode ? @image-url("icons/menu/lock.svg") : @image-url("icons/menu/unlock.svg");
                activated => { root.toggle-edit-mode(); }
            }
            MenuSeparator { }
            MenuItem {
                title: root.can-undo ? @tr("Undo: {}", root.undo-label) : @tr("Undo");
                icon: @image-url("icons/menu/undo.svg");
                shortcut: @keys(Control + Z);
                enabled: root.can-undo && root.can-edit;
                activated => { root.undo(); }
            }
            MenuSeparator { }
            MenuItem {
                title: root.texture-mode ? @tr("Add texture…") : @tr("Import files…");
                icon: @image-url("icons/menu/import.svg");
                enabled: (root.archive-mode || root.texture-mode) && root.can-edit;
                activated => {
                    if (root.texture-mode) {
                        root.texture-add();
                    } else {
                        root.archive-import();
                    }
                }
            }
            MenuItem {
                title: @tr("Replace…");
                icon: @image-url("icons/menu/replace.svg");
                enabled: ((root.archive-mode && root.entry-selected) || (root.texture-mode && root.texture-selected)) && root.can-edit;
                activated => { root.replace-selected(); }
            }
            MenuItem {
                title: @tr("Rename…");
                icon: @image-url("icons/menu/rename.svg");
                shortcut: @keys(F2);
                enabled: root.archive-mode && root.entry-selected && root.can-edit;
                activated => { root.archive-rename(); }
            }
            MenuItem {
                title: @tr("New folder…");
                icon: @image-url("icons/menu/new-folder.svg");
                shortcut: @keys(Control + Shift + N);
                enabled: root.archive-mode && root.can-edit;
                activated => { root.archive-new-folder(); }
            }
            MenuItem {
                title: root.texture-mode ? @tr("Remove texture") : @tr("Delete");
                icon: @image-url("icons/menu/trash.svg");
                enabled: ((root.archive-mode && root.entry-selected) || (root.texture-mode && root.texture-selected)) && root.can-edit;
                activated => { root.delete-selected(); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Open in viewer");
                icon: @image-url("icons/menu/expand.svg");
                shortcut: @keys(Control + Return);
                enabled: root.can-view;
                activated => { root.open-viewer(); }
            }
            MenuSeparator { }
            MenuItem {
                title: root.mods-overlay ? @tr("✓ Show mods overlay") : @tr("Show mods overlay");
                enabled: root.mods-available;
                activated => {
                    root.mods-overlay = !root.mods-overlay;
                    root.overlay-toggled(root.mods-overlay);
                }
            }
            MenuItem {
                title: @tr("All mod changes");
                enabled: root.mods-available;
                activated => { root.show-changes(); }
            }
            MenuItem {
                title: (root.history-in-window ? "✓ " : "") + @tr("History in its own window");
                activated => {
                    root.history-in-window = !root.history-in-window;
                    root.history-window-changed(root.history-in-window);
                }
            }
            MenuItem {
                title: @tr("History");
                icon: @image-url("icons/menu/history.svg");
                shortcut: @keys(Control + H);
                activated => { root.show-history(); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Theme");
                MenuItem {
                    title: (root.theme-mode == 0 ? "✓ " : "") + @tr("System");
                    activated => { root.set-theme(0); }
                }
                MenuItem {
                    title: (root.theme-mode == 1 ? "✓ " : "") + @tr("Light");
                    activated => { root.set-theme(1); }
                }
                MenuItem {
                    title: (root.theme-mode == 2 ? "✓ " : "") + @tr("Dark");
                    activated => { root.set-theme(2); }
                }
            }
        }
        Menu {
            title: @tr("Go");
            MenuItem {
                title: @tr("Back");
                icon: @image-url("icons/menu/back.svg");
                shortcut: @keys(Alt + LeftArrow);
                enabled: root.can-back;
                activated => { root.go-back(); }
            }
            MenuItem {
                title: @tr("Forward");
                icon: @image-url("icons/menu/forward.svg");
                shortcut: @keys(Alt + RightArrow);
                enabled: root.can-forward;
                activated => { root.go-forward(); }
            }
            MenuItem {
                title: @tr("Up");
                icon: @image-url("icons/menu/up.svg");
                shortcut: @keys(Alt + UpArrow);
                enabled: root.can-up;
                activated => { root.go-up(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Edit address");
                icon: @image-url("icons/menu/rename.svg");
                shortcut: @keys(Control + L);
                activated => { root.address-editing = true; }
            }
            MenuItem {
                title: @tr("Search");
                icon: @image-url("icons/menu/search.svg");
                shortcut: @keys(Control + F);
                activated => { search-edit.focus(); }
            }
            MenuItem {
                title: @tr("Filter list");
                icon: @image-url("icons/menu/search.svg");
                shortcut: @keys(Control + Shift + F);
                activated => { filter-edit.focus(); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Keyboard shortcuts");
                shortcut: @keys(F1);
                activated => { root.shortcuts-visible = true; }
            }
            MenuItem {
                title: @tr("Load native names…");
                activated => { root.load-natives(); }
            }
            MenuItem {
                title: @tr("About OpenRAGE");
                activated => { root.about-open(); }
            }
        }
    }

    VerticalLayout {
        // Toolbar: navigation · location · search · views · actions
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding: Theme.space-s;
                padding-left: Theme.space-m;
                padding-right: Theme.space-m;
                spacing: Theme.space-s;
                HorizontalLayout {
                    spacing: 2px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/back.svg");
                        label: @tr("Back (Alt+Left)");
                        enabled: root.can-back;
                        clicked => { root.go-back(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/forward.svg");
                        label: @tr("Forward (Alt+Right)");
                        enabled: root.can-forward;
                        clicked => { root.go-forward(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/up.svg");
                        label: @tr("Up (Alt+Up)");
                        enabled: root.can-up;
                        clicked => { root.go-up(); }
                    }
                }
                // Breadcrumbs; click the free space (or Ctrl+L) to type a path.
                Rectangle {
                    horizontal-stretch: 1;
                    min-height: 32px;
                    if root.address-editing: FocusScope {
                        KeyBinding {
                            keys: @keys(Escape);
                            activated => { root.address-editing = false; }
                        }
                        LineEdit {
                            // Fill the whole address bar (a FocusScope does not lay out its child).
                            width: parent.width;
                            height: parent.height;
                            text <=> root.address;
                            placeholder-text: @tr("Path, e.g. x64e.rpf/levels/gta5/vehicles.rpf");
                            accessible-label: @tr("Address");
                            accepted(text) => {
                                root.address-editing = false;
                                root.navigate(text);
                            }
                            changed has-focus => {
                                if (!self.has-focus) {
                                    root.address-editing = false;
                                }
                            }
                            init => { self.focus(); }
                        }
                    }
                    if !root.address-editing: Rectangle {
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: edit-area.has-hover ? Theme.text-faint : Theme.border;
                        background: Theme.background;
                        accessible-role: AccessibleRole.list;
                        accessible-label: @tr("Location");
                        edit-area := TouchArea {
                            mouse-cursor: text;
                            clicked => { root.address-editing = true; }
                        }
                        HorizontalLayout {
                            padding-left: Theme.space-xs;
                            padding-right: Theme.space-xs;
                            alignment: start;
                            for c[i] in root.crumbs: HorizontalLayout {
                                if i > 0: Text {
                                    text: "›";
                                    vertical-alignment: center;
                                    color: Theme.text-faint;
                                }
                                Rectangle {
                                    max-width: 240px;
                                    border-radius: Theme.radius-s;
                                    background: crumb-area.has-hover ? Theme.hover : transparent;
                                    accessible-role: button;
                                    accessible-label: c.label;
                                    accessible-action-default => { root.navigate(c.path); }
                                    crumb-area := TouchArea {
                                        clicked => { root.navigate(c.path); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: c.label;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            font-weight: i == root.crumbs.length - 1 ? 600 : 400;
                                            color: i == root.crumbs.length - 1 ? Theme.text : Theme.text-muted;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 16px;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/search.svg");
                        colorize: Theme.text-muted;
                        accessible-role: none;
                    }
                }
                search-edit := LineEdit {
                    width: 280px;
                    placeholder-text: @tr("Search names, hashes, text… (Ctrl+F)");
                    accessible-label: @tr("Search");
                    accepted(text) => { root.search(text); }
                }
                VSeparator { }
                if root.mods-available: Button {
                    text: @tr("Mods");
                    checkable: true;
                    checked <=> root.mods-overlay;
                    clicked => { root.overlay-toggled(self.checked); }
                    Tooltip {
                        text: @markdown("\{@tr("Show the game as the {} folder changes it", root.overlay-folder)}");
                    }
                }
                if root.mods-available: Button {
                    text: @tr("Changes");
                    clicked => { root.show-changes(); }
                    Tooltip {
                        text: @markdown("\{@tr("Every difference of all mods at once")}");
                    }
                }
                Button {
                    text: @tr("History");
                    icon: @image-url("icons/history.svg");
                    colorize-icon: true;
                    clicked => { root.show-history(); }
                }
                VSeparator { }
                Button {
                    text: root.edit-mode ? @tr("Editing") : @tr("Read-only");
                    icon: root.edit-mode ? @image-url("icons/unlock.svg") : @image-url("icons/lock.svg");
                    colorize-icon: true;
                    checkable: true;
                    checked: root.edit-mode;
                    clicked => {
                        self.checked = root.edit-mode;
                        root.toggle-edit-mode();
                    }
                    Tooltip {
                        text: @markdown("\{@tr("Edit mode: changes to archives are only possible when unlocked")}");
                    }
                }
                Button {
                    text: @tr("Extract…");
                    icon: @image-url("icons/extract.svg");
                    colorize-icon: true;
                    enabled: root.can-extract && !root.busy;
                    clicked => { root.extract-selected(); }
                }
                Button {
                    text: @tr("Install .oiv…");
                    icon: @image-url("icons/package.svg");
                    colorize-icon: true;
                    enabled: !root.busy;
                    clicked => { root.install-oiv(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Theme.dark ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                    label: Theme.dark ? @tr("Switch to light mode") : @tr("Switch to dark mode");
                    clicked => { root.set-theme(Theme.dark ? 1 : 2); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/settings.svg");
                    label: @tr("Settings");
                    clicked => { root.open-settings(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.edit-mode: EditModeStrip {
            folder: root.overlay-folder;
            in-game: root.write-in-game;
            lock => { root.edit-mode = false; }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // Folder tree
            Rectangle {
                width: root.tree-width;
                background: Theme.surface;
                VerticalLayout {
                    padding: Theme.space-xs;
                    ListView {
                        for row[i] in root.tree: TreeItem {
                            item: row;
                            selected: i == root.tree-selected;
                            toggle => { root.tree-toggle(i); }
                            activate => { root.tree-activate(i); }
                            action(a) => { root.tree-action(i, a); }
                        }
                    }
                }
            }

            Splitter {
                dragged(d) => { root.tree-width = max(180px, min(root.width / 2, root.tree-width + d)); }
            }

            // File list
            VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.space-s;
                padding-top: Theme.space-m;
                spacing: Theme.space-s;

                // Location header: where am I, how many items, filter
                HorizontalLayout {
                    spacing: Theme.space-m;
                    padding-left: Theme.space-xs;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.location-title;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            overflow: elide;
                            color: Theme.text;
                            accessible-role: text;
                        }
                        Text {
                            text: root.filter == "" ? @tr("{} items", root.total-count) : @tr("{} of {} items", root.files.length, root.total-count);
                            font-size: Theme.font-small;
                            color: Theme.text-muted;
                        }
                    }
                    filter-edit := LineEdit {
                        width: 200px;
                        text <=> root.filter;
                        placeholder-text: @tr("Filter this list");
                        accessible-label: @tr("Filter this list");
                        edited(text) => { root.filter-edited(text); }
                    }
                }

                if root.history-mode: ContextBar {
                    if !root.edit-mode: Button {
                        text: @tr("Unlock editing…");
                        icon: @image-url("icons/unlock.svg");
                        colorize-icon: true;
                        clicked => { root.unlock-visible = true; }
                    }
                    title: @tr("History");
                    description: @tr("Changes made to the {} folder, newest first. Everything can be undone.", root.overlay-folder);
                    Button {
                        text: @tr("Undo newest");
                        icon: @image-url("icons/undo.svg");
                        colorize-icon: true;
                        enabled: root.can-undo && root.can-edit;
                        clicked => { root.undo(); }
                    }
                    Button {
                        text: root.history-group == "" ? @tr("Uninstall package") : @tr("Uninstall “{}”", root.history-group);
                        icon: @image-url("icons/remove.svg");
                        colorize-icon: true;
                        primary: root.history-group != "";
                        enabled: root.history-group != "" && root.can-edit;
                        clicked => { root.uninstall-group(); }
                    }
                }
                if root.archive-mode: ContextBar {
                    title: root.in-mods ? @tr("Archive in the {} folder", root.overlay-folder) : @tr("Original game archive");
                    description: !root.edit-mode ? @tr("Read-only. Unlock editing to change it.")
                        : root.in-mods ? @tr("Changes apply to this copy and can be undone.")
                        : root.write-in-game ? @tr("Changes go into this game file; its original is kept and can be restored in History.")
                        : @tr("Changes are copied to the {} folder; the game file stays untouched.", root.overlay-folder);
                    background: root.edit-mode && !root.in-mods ? Theme.warning.with-alpha(0.14) : Theme.accent-subtle;
                    if !root.edit-mode: Button {
                        text: @tr("Unlock editing…");
                        icon: @image-url("icons/unlock.svg");
                        colorize-icon: true;
                        clicked => { root.unlock-visible = true; }
                    }
                    if root.edit-mode: Button {
                        text: @tr("Import…");
                        icon: @image-url("icons/import.svg");
                        colorize-icon: true;
                        primary: true;
                        enabled: root.can-edit;
                        clicked => { root.archive-import(); }
                    }
                    if root.edit-mode: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/new-folder.svg");
                        label: @tr("New folder… (Ctrl+Shift+N)");
                        enabled: root.can-edit;
                        clicked => { root.archive-new-folder(); }
                    }
                    if root.edit-mode: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/replace.svg");
                        label: @tr("Replace…");
                        enabled: root.entry-selected && root.can-edit;
                        clicked => { root.archive-replace(); }
                    }
                    if root.edit-mode: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/rename.svg");
                        label: @tr("Rename… (F2)");
                        enabled: root.entry-selected && root.can-edit;
                        clicked => { root.archive-rename(); }
                    }
                    if root.edit-mode: VSeparator { }
                    if root.edit-mode: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/trash.svg");
                        tint: Theme.danger;
                        label: @tr("Delete (Del)");
                        enabled: root.entry-selected && root.can-edit;
                        clicked => { root.archive-delete(); }
                    }
                }
                if root.texture-mode && root.textures-locked: ContextBar {
                    title: root.textures-game != "" ? @tr("{} textures", root.textures-game) : @tr("Particle textures");
                    description: root.textures-game != "" ? @tr("View and extract them as DDS or PNG (changing them is not supported yet).") : @tr("The textures inside a particle dictionary: view and extract them (changing them is not supported yet).");
                    Button {
                        text: @tr("Save PNG…");
                        icon: @image-url("icons/image.svg");
                        colorize-icon: true;
                        enabled: !root.busy;
                        clicked => { root.save-png(); }
                    }
                }
                if root.texture-mode && !root.textures-locked: ContextBar {
                    title: @tr("Texture dictionary");
                    description: !root.edit-mode ? @tr("Read-only. Unlock editing to change textures.")
                        : root.in-mods ? @tr("Changes apply to the copy in the {} folder.", root.overlay-folder)
                        : root.write-in-game ? @tr("Changes go into this game file; its original is kept and can be restored in History.")
                        : @tr("Changes are copied to the {} folder; the game file stays untouched.", root.overlay-folder);
                    background: root.edit-mode && !root.in-mods ? Theme.warning.with-alpha(0.14) : Theme.accent-subtle;
                    Button {
                        text: @tr("Save PNG…");
                        icon: @image-url("icons/image.svg");
                        colorize-icon: true;
                        enabled: !root.busy;
                        clicked => { root.save-png(); }
                    }
                    if !root.edit-mode: Button {
                        text: @tr("Unlock editing…");
                        icon: @image-url("icons/unlock.svg");
                        colorize-icon: true;
                        clicked => { root.unlock-visible = true; }
                    }
                    if root.edit-mode: Button {
                        text: @tr("Add…");
                        icon: @image-url("icons/plus.svg");
                        colorize-icon: true;
                        primary: true;
                        enabled: root.can-edit;
                        clicked => { root.texture-add(); }
                    }
                    if root.edit-mode: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/replace.svg");
                        label: @tr("Replace…");
                        enabled: root.texture-selected && root.can-edit;
                        clicked => { root.texture-replace(); }
                    }
                    if root.edit-mode: VSeparator { }
                    if root.edit-mode: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/trash.svg");
                        tint: Theme.danger;
                        label: @tr("Remove (Del)");
                        enabled: root.texture-selected && root.can-edit;
                        clicked => { root.texture-remove(); }
                    }
                }
                if root.audio-mode-folder: ContextBar {
                    title: @tr("Audio container");
                    description: @tr("Double-click a sound to play it. Extract… saves WAV files.");
                    Button {
                        text: @tr("Save all as WAV…");
                        icon: @image-url("icons/extract.svg");
                        colorize-icon: true;
                        enabled: !root.busy;
                        clicked => { root.extract-selected(); }
                    }
                }
                if root.search-mode: ContextBar {
                    title: @tr("Search results");
                    description: root.search-summary;
                    if root.show-language: ComboBox {
                        width: 180px;
                        model: root.languages;
                        current-index <=> root.language-index;
                        selected => { root.language-picked(self.current-index); }
                    }
                }

                // Column headers + list
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius;
                    border-width: drop.has-drag ? 2px : 1px;
                    border-color: drop.has-drag || list-scope.has-focus ? Theme.accent : Theme.border;
                    clip: true;
                    VerticalLayout {
                        Rectangle {
                            height: 28px;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: Theme.space-s + Theme.icon-size + Theme.space-s;
                                padding-right: Theme.space-s;
                                spacing: Theme.space-s;
                                HeaderCell {
                                    horizontal-stretch: 1;
                                    min-width: 80px;
                                    preferred-width: 100px;
                                    label: @tr("Name");
                                    active: root.sort-column == 0;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(0); }
                                }
                                HeaderCell {
                                    width: root.search-mode ? root.col-location-width : root.col-kind-width;
                                    resizable: true;
                                    resized(d) => {
                                        if (root.search-mode) {
                                            root.col-location-width = max(60px, min(900px, root.col-location-width + d));
                                        } else {
                                            root.col-kind-width = max(60px, min(400px, root.col-kind-width + d));
                                        }
                                    }
                                    label: root.search-mode ? @tr("Location") : @tr("Type");
                                    active: !root.search-mode && root.sort-column == 1;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(1); }
                                }
                                HeaderCell {
                                    width: root.col-size-width;
                                    resizable: true;
                                    resized(d) => { root.col-size-width = max(48px, min(200px, root.col-size-width + d)); }
                                    align: right;
                                    label: @tr("Size");
                                    active: root.sort-column == 2;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(2); }
                                }
                                HeaderCell {
                                    width: root.col-info-width;
                                    resizable: true;
                                    resized(d) => { root.col-info-width = max(48px, min(400px, root.col-info-width + d)); }
                                    label: @tr("Info");
                                    active: root.sort-column == 3;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(3); }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        list-scope := FocusScope {
                            vertical-stretch: 1;
                            accessible-role: AccessibleRole.list;
                            accessible-label: @tr("Files");
                            KeyBinding {
                                keys: @keys(DownArrow);
                                activated => { root.move-selection(1); }
                            }
                            KeyBinding {
                                keys: @keys(UpArrow);
                                activated => { root.move-selection(-1); }
                            }
                            KeyBinding {
                                keys: @keys(PageDown);
                                activated => { root.move-selection(max(1, floor(list.visible-height / Theme.row-height) - 1)); }
                            }
                            KeyBinding {
                                keys: @keys(PageUp);
                                activated => { root.move-selection(-max(1, floor(list.visible-height / Theme.row-height) - 1)); }
                            }
                            KeyBinding {
                                keys: @keys(Home);
                                activated => { root.move-selection(-root.files.length); }
                            }
                            KeyBinding {
                                keys: @keys(End);
                                activated => { root.move-selection(root.files.length); }
                            }
                            KeyBinding {
                                keys: @keys(Return);
                                activated => {
                                    if (root.file-selected >= 0) {
                                        root.file-open(root.file-selected);
                                    }
                                }
                            }
                            KeyBinding {
                                keys: @keys(Backspace);
                                enabled: root.can-up;
                                activated => { root.go-up(); }
                            }
                            KeyBinding {
                                keys: @keys(" ");
                                enabled: root.audio-mode;
                                activated => { root.audio-toggle(); }
                            }
                            KeyBinding {
                                keys: @keys(Delete);
                                activated => { root.delete-selected(); }
                            }
                            Rectangle {
                                drop := DropArea {
                                    enabled: root.archive-mode && root.can-edit;
                                    can-drop(event) => { return DragAction.copy; }
                                    dropped(event) => {
                                        root.files-dropped(event.data);
                                        return DragAction.copy;
                                    }
                                }
                                list := ListView {
                                    for row[i] in root.files: FileItem {
                                        item: row;
                                        wide-kind: root.search-mode;
                                        kind-width: root.search-mode ? root.col-location-width : root.col-kind-width;
                                        size-width: root.col-size-width;
                                        info-width: root.col-info-width;
                                        odd: Math.mod(i, 2) == 1;
                                        selected: i == root.file-selected;
                                        focused: list-scope.has-focus;
                                        archive-mode: root.archive-mode;
                                        texture-mode: root.texture-mode;
                                        history-mode: root.history-mode;
                                        can-edit: root.can-edit;
                                        select => {
                                            list-scope.focus();
                                            root.file-select(i);
                                        }
                                        open => { root.file-open(i); }
                                        action(a) => {
                                            list-scope.focus();
                                            root.row-action(i, a);
                                        }
                                    }
                                }
                                // Empty states
                                if root.files.length == 0 && !root.busy: VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-xs;
                                    padding: Theme.space-xl;
                                    Text {
                                        horizontal-alignment: center;
                                        font-size: Theme.font-title;
                                        font-weight: 600;
                                        color: Theme.text-muted;
                                        text: root.filter != "" ? @tr("Nothing matches “{}”", root.filter)
                                            : root.search-mode ? @tr("No results")
                                            : root.history-mode ? @tr("No changes yet")
                                            : @tr("This folder is empty");
                                    }
                                    Text {
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        color: Theme.text-faint;
                                        text: root.filter != "" ? @tr("Clear the filter to see all items.")
                                            : root.search-mode ? @tr("Try another term, a hash such as 0xB779A091, or search all languages.")
                                            : root.history-mode ? @tr("Changes you make to archives and installed packages appear here and can be undone.")
                                            : root.archive-mode ? @tr("Import files or drop them here.") : "";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Splitter {
                dragged(d) => { root.preview-width = max(280px, min(root.width / 2, root.preview-width - d)); }
            }

            // Info + preview
            VerticalLayout {
                width: root.preview-width;
                padding: Theme.space-l;
                padding-top: Theme.space-m;
                spacing: Theme.space-m;

                // Header: what is selected
                VerticalLayout {
                    spacing: Theme.space-xs;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        FormatIcon {
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            name: root.info-icon;
                            tint: root.info-tint;
                        }
                        Text {
                            text: root.info-title;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            overflow: elide;
                            color: Theme.text;
                        }
                    }
                    if root.info-path != "": Text {
                        text: root.info-path;
                        font-family: root.mono-font;
                        font-size: Theme.font-small;
                        wrap: char-wrap;
                        color: Theme.text-muted;
                    }
                }
                if root.info-rows.length > 0: Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: Theme.space-m;
                        padding-top: Theme.space-s;
                        padding-bottom: Theme.space-s;
                        spacing: Theme.space-xs;
                        for r in root.info-rows: HorizontalLayout {
                            spacing: Theme.space-m;
                            if r.key != "": Text {
                                width: 120px;
                                text: r.key;
                                font-size: Theme.font-small;
                                color: Theme.text-muted;
                                overflow: elide;
                                vertical-alignment: top;
                            }
                            InfoValue {
                                horizontal-stretch: 1;
                                text: r.value;
                                color: r.key == "" ? Theme.text-muted : r.key == "Error" ? Theme.danger : Theme.text;
                                font-size: r.key == "" ? Theme.font-small : Theme.font-body;
                            }
                        }
                    }
                }

                // Actions for the selection
                if root.can-view: HorizontalLayout {
                    spacing: Theme.space-s;
                    Button {
                        text: @tr("Open viewer");
                        icon: @image-url("icons/expand.svg");
                        colorize-icon: true;
                        clicked => { root.open-viewer(); }
                    }
                    if root.model-mode && root.model-textures > 0: Button {
                        text: @tr("Textures ({})", root.model-textures);
                        icon: @image-url("icons/image.svg");
                        colorize-icon: true;
                        clicked => { root.open-model-textures(); }
                    }
                    if root.model-mode: Button {
                        text: @tr("Export glTF…");
                        icon: @image-url("icons/export.svg");
                        colorize-icon: true;
                        enabled: !root.busy;
                        clicked => { root.export-gltf(); }
                    }
                    if root.texture-mode: Button {
                        text: @tr("Save PNG…");
                        icon: @image-url("icons/image.svg");
                        colorize-icon: true;
                        enabled: !root.busy;
                        clicked => { root.save-png(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                if root.audio-mode: Rectangle {
                    height: 50px;
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    // Every control sits centred in a cell spanning the row's height.
                    HorizontalLayout {
                        padding-left: Theme.space-s;
                        padding-right: Theme.space-s;
                        spacing: 2px;
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/prev.svg");
                                label: @tr("Previous sound");
                                enabled: root.audio-has-prev;
                                clicked => { root.audio-step(-1); }
                            }
                        }
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/back5.svg");
                                label: @tr("Back 5 seconds");
                                clicked => { root.audio-skip(-5); }
                            }
                        }
                        Rectangle {
                            width: 44px;
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 38px;
                                height: 38px;
                                border-radius: 19px;
                                background: play-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                                accessible-role: button;
                                accessible-label: root.audio-playing ? @tr("Pause") : @tr("Play");
                                accessible-action-default => { root.audio-toggle(); }
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    // The play triangle's visual centre is left of its box.
                                    x: (parent.width - self.width) / 2 + (root.audio-playing ? 0px : 1.5px);
                                    y: (parent.height - self.height) / 2;
                                    source: root.audio-playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                    colorize: Palette.accent-foreground;
                                }
                                play-ta := TouchArea {
                                    clicked => { root.audio-toggle(); }
                                }
                                Tooltip {
                                    text: @markdown("\{@tr("Play / pause (Space)")}");
                                }
                            }
                        }
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/fwd5.svg");
                                label: @tr("Forward 5 seconds");
                                clicked => { root.audio-skip(5); }
                            }
                        }
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/next.svg");
                                label: @tr("Next sound");
                                enabled: root.audio-has-next;
                                clicked => { root.audio-step(1); }
                            }
                        }
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/stop.svg");
                                label: @tr("Stop");
                                clicked => { root.audio-stop(); }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: root.audio-time;
                            font-family: root.mono-font;
                            font-size: Theme.font-small;
                            color: Theme.text-muted;
                        }
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/repeat.svg");
                                label: root.audio-play-all ? @tr("Playing all sounds in a row (click to stop after this one)") : @tr("Play all sounds in a row");
                                active: root.audio-play-all;
                                clicked => { root.audio-play-all = !root.audio-play-all; }
                            }
                        }
                        Rectangle {
                            width: 32px;
                            IconButton {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/extract.svg");
                                label: @tr("Save WAV…");
                                enabled: !root.busy;
                                clicked => { root.audio-save-wav(); }
                            }
                        }
                    }
                }
                preview-area := Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface-raised;
                    clip: true;
                    if root.has-image: Image {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        source: root.preview-image;
                        image-fit: contain;
                        image-rendering: smooth;
                        accessible-role: image;
                        accessible-label: @tr("Preview of {}", root.info-title);
                    }
                    if root.audio-mode: Rectangle {
                        x: 8px + (parent.width - 16px) * root.audio-position;
                        width: 2px;
                        background: Theme.accent;
                    }
                    if root.audio-mode: TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.audio-seek(max(0, min(1, (self.mouse-x - 8px) / (self.width - 16px)))); }
                    }
                    if root.audio-mode: Text {
                        x: Theme.space-s;
                        y: parent.height - self.height - Theme.space-s;
                        text: @tr("Click the waveform to jump · Space plays and pauses");
                        font-size: Theme.font-small;
                        color: Theme.text-faint;
                    }
                    if root.model-mode: ModelControls {
                        orbit(dx, dy) => { root.model-orbit(dx, dy); }
                        zoom(d) => { root.model-zoom(d); }
                        double-clicked => { root.open-viewer(); }
                    }
                    if root.model-mode: AxisGizmo {
                        x: parent.width - self.width - Theme.space-s;
                        y: parent.height - self.height - Theme.space-s;
                        axes: root.gizmo;
                        pick(i) => { root.model-axis(i); }
                    }
                    if root.model-mode: Text {
                        x: Theme.space-s;
                        y: parent.height - self.height - Theme.space-s;
                        text: @tr("Drag to rotate · scroll to zoom");
                        font-size: Theme.font-small;
                        color: Theme.text-faint;
                    }
                    if !root.has-image && root.preview-text != "": ScrollView {
                        content-width: max(self.visible-width, preview.preferred-width + 16px);
                        content-height: max(self.visible-height, preview.preferred-height + 16px);
                        preview := Text {
                            x: 8px;
                            y: 8px;
                            text: root.preview-text;
                            font-family: root.mono-font;
                            font-size: 12px;
                            wrap: no-wrap;
                            color: Theme.text;
                        }
                    }
                    if root.suggest-pending && root.suggestions.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-m;
                        HorizontalLayout {
                            alignment: center;
                            Spinner {
                                width: 32px;
                                height: 32px;
                                indeterminate: true;
                            }
                        }
                        Text {
                            horizontal-alignment: center;
                            text: root.suggest-title;
                            wrap: word-wrap;
                            color: Theme.text-muted;
                        }
                    }
                    if root.suggestions.length > 0: VerticalLayout {
                        padding: Theme.space-m;
                        spacing: Theme.space-s;
                        Text {
                            text: root.suggest-title;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for m[i] in root.suggestions: Rectangle {
                                height: 42px;
                                border-radius: Theme.radius-s;
                                background: sug-ta.has-hover ? Theme.hover : transparent;
                                sug-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.suggestion-open(i); }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.space-s;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-s;
                                    FormatIcon {
                                        y: (parent.height - self.height) / 2;
                                        name: root.suggest-icon;
                                        tint: root.suggest-icon == "audio" ? #db4f8a : #3b82f6;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: m.name;
                                            overflow: elide;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: m.info;
                                            font-size: Theme.font-small;
                                            overflow: elide;
                                            color: Theme.text-faint;
                                        }
                                    }
                                    Text {
                                        text: "▶";
                                        vertical-alignment: center;
                                        color: Theme.accent;
                                    }
                                }
                            }
                        }
                    }
                    if !root.has-image && root.preview-text == "" && !root.preview-loading && !root.suggest-pending && root.suggestions.length == 0: Text {
                        width: parent.width - 2 * Theme.space-xl;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        color: Theme.text-faint;
                        // After a search without results, say what was looked for.
                        text: root.suggest-title != "" ? root.suggest-title : root.has-selection ? @tr("No preview for this file type") : @tr("Select a file to preview it");
                    }
                    if root.preview-loading: VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-s;
                        HorizontalLayout {
                            alignment: center;
                            Spinner {
                                width: 40px;
                                height: 40px;
                                // Known count: a ring that fills; otherwise endless.
                                indeterminate: root.preview-progress < 0;
                                progress: max(root.preview-progress, 0);
                            }
                        }
                        if root.preview-progress-text != "": Text {
                            horizontal-alignment: center;
                            text: root.preview-progress-text;
                            font-size: Theme.font-small;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Status bar
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.space-m;
                padding-right: Theme.space-m;
                spacing: Theme.space-m;
                height: 30px;
                Text {
                    horizontal-stretch: 1;
                    text: root.status;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                    color: root.status-is-error ? Theme.danger : Theme.text-muted;
                    accessible-role: text;
                    accessible-label: root.status-is-error ? @tr("Error: {}", root.status) : root.status;
                    Tooltip {
                        text: @markdown("\{root.status}");
                    }
                }
                Text {
                    text: root.index-status;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    color: Theme.text-muted;
                }
                if root.busy: Spinner {
                    width: 16px;
                    indeterminate: true;
                }
                if root.busy && root.cancellable: Button {
                    text: @tr("Cancel");
                    clicked => { root.cancel-task(); }
                }
            }
        }
    }

    // OpenIV package preview
    if root.oiv-visible: Dialog {
        title: root.oiv-title;
        subtitle: root.oiv-subtitle;
        panel-width: 760px;
        panel-height: 640px;
        closable: !root.oiv-running;
        close => { root.oiv-visible = false; }
        if root.oiv-description != "": Text {
            text: root.oiv-description;
            wrap: word-wrap;
            max-height: 80px;
            overflow: elide;
            color: Theme.text;
        }
        Text {
            text: @tr("Changes — written to the {} folder, can be uninstalled from History", root.overlay-folder);
            font-weight: 600;
            color: Theme.text;
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-raised;
            border-radius: Theme.radius;
            ScrollView {
                content-width: max(self.visible-width, changes.preferred-width + 16px);
                content-height: max(self.visible-height, changes.preferred-height + 16px);
                changes := Text {
                    x: 8px;
                    y: 8px;
                    text: root.oiv-changes;
                    font-family: root.mono-font;
                    font-size: 12px;
                    color: Theme.text;
                }
            }
        }
        if root.oiv-problems != "": Rectangle {
            border-radius: Theme.radius;
            background: (root.oiv-can-install ? Theme.warning : Theme.danger).with-alpha(0.12);
            HorizontalLayout {
                padding: Theme.space-s;
                Text {
                    text: root.oiv-problems;
                    wrap: word-wrap;
                    color: root.oiv-can-install ? Theme.warning : Theme.danger;
                }
            }
        }
        if !root.edit-mode: Rectangle {
            border-radius: Theme.radius;
            background: Theme.accent-subtle;
            HorizontalLayout {
                padding: Theme.space-s;
                padding-left: Theme.space-m;
                spacing: Theme.space-s;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    text: @tr("Installing needs edit mode.");
                    color: Theme.text;
                }
                Button {
                    text: @tr("Unlock editing…");
                    icon: @image-url("icons/unlock.svg");
                    colorize-icon: true;
                    clicked => { root.unlock-visible = true; }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-s;
            if root.oiv-running: Spinner {
                width: 24px;
                indeterminate: true;
            }
            Button {
                text: @tr("Cancel");
                enabled: !root.oiv-running;
                clicked => { root.oiv-visible = false; }
            }
            Button {
                text: @tr("Install");
                primary: true;
                enabled: root.oiv-can-install && !root.oiv-running && root.edit-mode;
                clicked => { root.oiv-confirm(); }
            }
        }
    }

    // Text prompt (rename, new folder)
    if root.prompt-visible: Dialog {
        title: root.prompt-title;
        panel-width: 460px;
        panel-height: 190px;
        close => { root.prompt-visible = false; }
        prompt-edit := LineEdit {
            text <=> root.prompt-value;
            accessible-label: root.prompt-title;
            accepted(text) => { root.prompt-accepted(text); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-s;
            Button {
                text: @tr("Cancel");
                clicked => { root.prompt-visible = false; }
            }
            Button {
                text: @tr("OK");
                primary: true;
                enabled: root.prompt-value != "";
                clicked => { root.prompt-accepted(root.prompt-value); }
            }
        }
        init => { prompt-edit.focus(); }
    }

    // Keyboard shortcuts
    if root.shortcuts-visible: Dialog {
        title: @tr("Keyboard shortcuts");
        panel-width: 520px;
        panel-height: 500px;
        close => { root.shortcuts-visible = false; }
        GridLayout {
            spacing-horizontal: Theme.space-xl;
            spacing-vertical: Theme.space-s;
            Row {
                Text { text: "↑ ↓ · PgUp PgDn · Home End"; color: Theme.text-muted; }
                Text { text: @tr("Move the selection in the list"); color: Theme.text; }
            }
            Row {
                Text { text: "Enter"; color: Theme.text-muted; }
                Text { text: @tr("Open folder, archive or texture dictionary"); color: Theme.text; }
            }
            Row {
                Text { text: "Ctrl+Enter"; color: Theme.text-muted; }
                Text { text: @tr("Open the model or image in the viewer"); color: Theme.text; }
            }
            Row {
                Text { text: "Backspace · Alt+Up"; color: Theme.text-muted; }
                Text { text: @tr("Go up one level"); color: Theme.text; }
            }
            Row {
                Text { text: "Alt+Left · Alt+Right"; color: Theme.text-muted; }
                Text { text: @tr("Back · forward"); color: Theme.text; }
            }
            Row {
                Text { text: "Ctrl+L · Ctrl+F · Ctrl+Shift+F"; color: Theme.text-muted; }
                Text { text: @tr("Address · search · filter"); color: Theme.text; }
            }
            Row {
                Text { text: "F2 · Delete"; color: Theme.text-muted; }
                Text { text: @tr("Rename · delete (inside archives)"); color: Theme.text; }
            }
            Row {
                Text { text: "Ctrl+Z"; color: Theme.text-muted; }
                Text { text: @tr("Undo the newest change"); color: Theme.text; }
            }
            Row {
                Text { text: "Ctrl+E · Ctrl+O"; color: Theme.text-muted; }
                Text { text: @tr("Extract · install .oiv package"); color: Theme.text; }
            }
            Row {
                Text { text: @tr("Right-click"); color: Theme.text-muted; }
                Text { text: @tr("Actions for a file"); color: Theme.text; }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    if root.about-visible: Dialog {
        title: @tr("About OpenRAGE");
        subtitle: root.about-version;
        panel-width: 980px;
        panel-height: 680px;
        close => { root.about-visible = false; }
        TabWidget {
            vertical-stretch: 1;
            current-index <=> root.about-tab;
            Tab {
                title: @tr("OpenRAGE");
                VerticalLayout {
                    padding: Theme.space-l;
                    spacing: Theme.space-l;
                    HorizontalLayout {
                        spacing: Theme.space-l;
                        Image {
                            source: @image-url("logo.svg");
                            width: 72px;
                            height: 72px;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-xs;
                            Text {
                                text: "OpenRAGE";
                                font-size: Theme.font-heading;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: root.about-version + " · GPL-3.0-only";
                                color: Theme.text-muted;
                            }
                            Text {
                                text: @tr("Open-source explorer and mod tool for RAGE engine games");
                                color: Theme.text-muted;
                            }
                        }
                    }
                    Text {
                        text: root.about-notice;
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        Button {
                            text: @tr("Source code");
                            clicked => { root.about-open-source(); }
                        }
                        Button {
                            text: @tr("GPL-3.0 text");
                            clicked => { root.about-show("gpl"); }
                        }
                        Button {
                            text: @tr("AGPL-3.0 text (rage-tfit2)");
                            clicked => { root.about-show("agpl"); }
                        }
                        Button {
                            text: @tr("Third-party licenses");
                            clicked => { root.about-tab = 2; }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
            Tab {
                title: @tr("Credits");
                ScrollView {
                    VerticalLayout {
                        padding: Theme.space-l;
                        spacing: Theme.space-l;
                        for c in root.about-credits: VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: c.key;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: c.value;
                                wrap: word-wrap;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }
            Tab {
                title: @tr("Third-party licenses");
                HorizontalLayout {
                    padding: Theme.space-s;
                    spacing: Theme.space-m;
                    VerticalLayout {
                        width: 360px;
                        spacing: Theme.space-s;
                        LineEdit {
                            placeholder-text: @tr("Filter crates and licenses");
                            text <=> root.about-filter;
                            edited(t) => { root.about-filter-edited(t); }
                        }
                        Text {
                            text: root.about-deps-summary;
                            font-size: Theme.font-small;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for d[i] in root.about-deps: Rectangle {
                                height: 40px;
                                background: i == root.about-selected ? Theme.accent-subtle : dta.has-hover ? Theme.hover : Math.mod(i, 2) == 1 ? Theme.stripe : transparent;
                                dta := TouchArea {
                                    clicked => { root.about-select(i); }
                                }
                                VerticalLayout {
                                    padding-left: Theme.space-s;
                                    padding-right: Theme.space-s;
                                    alignment: center;
                                    Text {
                                        text: d.name + "  " + d.version;
                                        overflow: elide;
                                        color: Theme.text;
                                    }
                                    Text {
                                        text: d.license;
                                        overflow: elide;
                                        font-size: Theme.font-small;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }
                    TextEdit {
                        horizontal-stretch: 1;
                        read-only: true;
                        wrap: word-wrap;
                        font-size: 12px;
                        text: root.about-text;
                    }
                }
            }
        }
    }

    // Edit mode warning
    if root.unlock-visible: UnlockDialog {
        folder: root.overlay-folder;
        can-choose: root.can-write-in-game;
        in-game: root.write-in-game;
        choose(on) => { root.write-target-changed(on); }
        width: root.width;
        height: root.height;
        confirm => {
            root.edit-mode = true;
            root.unlock-visible = false;
        }
        cancel => { root.unlock-visible = false; }
    }

    // Which game to open: at start (several games, no default) or File → Switch game….
    if root.game-chooser-visible: Dialog {
        title: @tr("Open a game");
        panel-width: 560px;
        panel-height: 150px + root.games.length * 64px + 60px;
        closable: root.game-chooser-can-cancel;
        close => { root.game-chooser-visible = false; }
        for g[i] in root.games: Rectangle {
            height: 56px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: card-ta.has-hover ? Theme.accent : Theme.border;
            background: g.is-current ? Theme.accent-subtle : card-ta.has-hover ? Theme.hover : transparent;
            card-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.game-chooser-visible = false;
                    root.game-chosen(i, root.game-remember);
                }
            }
            HorizontalLayout {
                padding: Theme.space-s;
                spacing: Theme.space-m;
                Image {
                    source: @image-url("logo.svg");
                    width: 36px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: g.name + (g.is-default ? "  · " + @tr("default") : "") + (g.is-current ? "  · " + @tr("open now") : "");
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: g.path;
                        font-size: Theme.font-small;
                        overflow: elide;
                        color: Theme.text-muted;
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        CheckBox {
            text: @tr("Always open this game (change it in Settings)");
            checked <=> root.game-remember;
        }
        HorizontalLayout {
            alignment: space-between;
            Button {
                text: @tr("Add a game…");
                clicked => {
                    root.game-chooser-visible = false;
                    root.open-setup();
                }
            }
            if root.game-chooser-can-cancel: Button {
                text: @tr("Cancel");
                clicked => { root.game-chooser-visible = false; }
            }
        }
    }

    // Settings page: appearance, game, behaviour.
    if root.settings-visible: Dialog {
        title: @tr("Settings");
        panel-width: 560px;
        panel-height: 560px;
        closable: true;
        close => { root.settings-visible = false; }
        property <color> chosen: root.parse-hex(root.accent-hex);
        ScrollView {
            vertical-stretch: 1;
            // Debug snapshots of the plugin list (`OPENRAGE_SETTINGS=plugins`).
            changed content-height => {
                if root.settings-scroll-end {
                    self.content-y = self.visible-height - self.content-height;
                }
            }
            VerticalLayout {
                spacing: Theme.space-m;
                padding-right: Theme.space-m;
                Text {
                    text: @tr("Appearance");
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    Text {
                        width: 120px;
                        text: @tr("Theme");
                        vertical-alignment: center;
                        color: Theme.text-muted;
                    }
                    Button {
                        text: @tr("System");
                        primary: root.theme-mode == 0;
                        clicked => { root.set-theme(0); }
                    }
                    Button {
                        text: @tr("Light");
                        primary: root.theme-mode == 1;
                        clicked => { root.set-theme(1); }
                    }
                    Button {
                        text: @tr("Dark");
                        primary: root.theme-mode == 2;
                        clicked => { root.set-theme(2); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    Text {
                        width: 120px;
                        text: @tr("Accent color");
                        vertical-alignment: center;
                        color: Theme.text-muted;
                    }
                    Button {
                        text: @tr("OpenRAGE orange");
                        primary: Theme.accent-mode == 1;
                        clicked => { root.accent-chosen(1, Theme.accent-custom); }
                    }
                    Button {
                        text: @tr("System default");
                        primary: Theme.accent-mode == 0;
                        clicked => { root.accent-chosen(0, Theme.accent-custom); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    padding-left: 120px + Theme.space-s;
                    for c in [#c2410c, #2563eb, #0891b2, #16a34a, #9333ea, #db2777, #ca8a04]: Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: c;
                        border-width: Theme.accent-mode == 2 && Theme.accent-custom == c ? 3px : 0px;
                        border-color: Theme.text;
                        accessible-role: button;
                        accessible-label: root.color-hex(c);
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.accent-hex = root.color-hex(c);
                                root.accent-chosen(2, c);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    padding-left: 120px + Theme.space-s;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: chosen;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.accent-hex;
                        accessible-label: @tr("Own color as #rrggbb");
                        placeholder-text: @tr("Own color, e.g. #c2410c");
                        accepted => {
                            if (chosen.alpha > 0) {
                                root.accent-chosen(2, chosen);
                            }
                        }
                    }
                    Button {
                        text: @tr("Use");
                        enabled: chosen.alpha > 0;
                        clicked => { root.accent-chosen(2, chosen); }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                Text {
                    text: @tr("Game");
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    Image {
                        source: @image-url("logo.svg");
                        width: 32px;
                        height: 32px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: root.settings-game;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: root.settings-game-dir;
                            font-size: Theme.font-small;
                            wrap: char-wrap;
                            color: Theme.text-muted;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-s;
                    Button {
                        text: @tr("Switch game…");
                        enabled: root.games.length > 1;
                        clicked => {
                            root.settings-visible = false;
                            root.open-game-chooser(true);
                        }
                    }
                    Button {
                        text: @tr("Add or change a game…");
                        clicked => {
                            root.settings-visible = false;
                            root.open-setup();
                        }
                    }
                }
                CheckBox {
                    text: @tr("Ask which game to open at start");
                    enabled: root.games.length > 1;
                    checked: root.ask-game;
                    toggled => { root.ask-game-changed(self.checked); }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                Text {
                    text: @tr("Behaviour");
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                }
                CheckBox {
                    text: @tr("Show the change history in its own window");
                    checked: root.history-in-window;
                    toggled => {
                        root.history-in-window = self.checked;
                        root.history-window-changed(self.checked);
                    }
                }
                CheckBox {
                    text: @tr("Show the game as it sees itself with mods (mods overlay)");
                    enabled: root.mods-available;
                    checked: root.mods-overlay;
                    toggled => {
                        root.mods-overlay = self.checked;
                        root.overlay-toggled(self.checked);
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                Text {
                    text: @tr("Plugins");
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("Plugins add previews and actions for more file types. They run in a sandbox: they see only the files you open with them, plus the game's files if you allow it, and cannot change anything or go online. New plugins stay off until you turn them on.");
                    wrap: word-wrap;
                    color: Theme.text-muted;
                }
                if root.plugins.length == 0: Text {
                    text: @tr("No plugins installed. Put a plugin's folder into the plugin folder, then reload.");
                    wrap: word-wrap;
                    color: Theme.text-muted;
                }
                for p in root.plugins: HorizontalLayout {
                    spacing: Theme.space-s;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: p.title + "  ·  " + p.status;
                            font-weight: 600;
                            color: p.broken ? Theme.danger : Theme.text;
                        }
                        if p.description != "": Text {
                            text: p.description;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                            color: Theme.text-muted;
                        }
                        Text {
                            text: p.permissions;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                            color: p.broken ? Theme.danger : Theme.text-muted;
                        }
                    }
                    if !p.broken: CheckBox {
                        text: @tr("On");
                        checked: p.enabled;
                        accessible-label: @tr("Enable {}", p.title);
                        toggled => { root.plugin-toggled(p.id, self.checked); }
                    }
                    if p.removable: VerticalLayout {
                        alignment: center;
                        Button {
                            text: @tr("Uninstall");
                            accessible-label: @tr("Uninstall {}", p.title);
                            clicked => { root.uninstall-plugin(p.id); }
                        }
                    }
                }
                Text {
                    text: root.plugin-folder;
                    font-size: Theme.font-small;
                    wrap: char-wrap;
                    color: Theme.text-muted;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-s;
                    Button {
                        text: @tr("Install plugin…");
                        primary: true;
                        clicked => { root.pick-plugin-package(); }
                    }
                    Button {
                        text: @tr("Open plugin folder");
                        clicked => { root.open-plugin-folder(); }
                    }
                    Button {
                        text: @tr("Reload plugins");
                        clicked => { root.reload-plugins(); }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: @tr("Close");
                primary: true;
                clicked => { root.settings-visible = false; }
            }
        }
    }

    // Installing a plugin package: what it is and may do, before anything is written.
    if root.plugin-pkg-visible: Dialog {
        title: root.plugin-pkg-title;
        subtitle: root.plugin-pkg-subtitle;
        panel-width: 640px;
        panel-height: 460px;
        close => { root.plugin-pkg-visible = false; }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-raised;
            border-radius: Theme.radius;
            ScrollView {
                content-width: max(self.visible-width, details.preferred-width + 16px);
                content-height: max(self.visible-height, details.preferred-height + 16px);
                details := Text {
                    x: 8px;
                    y: 8px;
                    width: parent.visible-width - 16px;
                    text: root.plugin-pkg-details;
                    wrap: word-wrap;
                    color: Theme.text;
                }
            }
        }
        Text {
            text: @tr("Plugins run in a sandbox. A new plugin stays off until you turn it on in Settings → Plugins.");
            wrap: word-wrap;
            font-size: Theme.font-small;
            color: Theme.text-muted;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-s;
            Button {
                text: @tr("Cancel");
                clicked => { root.plugin-pkg-visible = false; }
            }
            Button {
                text: @tr("Install");
                primary: true;
                clicked => { root.plugin-pkg-confirm(); }
            }
        }
    }

    // First-run / key setup
    if root.setup-visible: Dialog {
        title: @tr("Set up OpenRAGE");
        panel-width: 660px;
        panel-height: 520px;
        closable: root.setup-can-cancel && !root.setup-running;
        close => { root.setup-visible = false; }
        Image {
            source: @image-url("logo.svg");
            width: 48px;
            height: 48px;
        }
        Text {
            text: @tr("OpenRAGE reads the archive keys from your own copy of GTA V. No keys or game files are included with OpenRAGE.");
            wrap: word-wrap;
            color: Theme.text-muted;
        }
        if root.setup-detected.length > 0: HorizontalLayout {
            spacing: Theme.space-s;
            Text {
                text: @tr("Detected:");
                vertical-alignment: center;
                color: Theme.text;
            }
            ComboBox {
                horizontal-stretch: 1;
                model: root.setup-detected;
                selected(value) => { root.setup-pick-detected(value); }
            }
        }
        VerticalLayout {
            spacing: Theme.space-xs;
            Text {
                text: @tr("Game directory");
                font-weight: 600;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: Theme.space-s;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.setup-game-dir;
                    accessible-label: @tr("Game directory");
                    placeholder-text: @tr("Folder containing GTA5_Enhanced.exe, GTA5.exe, GTAIV.exe or RDR2.exe");
                }
                Button {
                    text: @tr("Browse…");
                    clicked => { root.setup-browse-game(); }
                }
            }
        }
        VerticalLayout {
            spacing: Theme.space-xs;
            Text {
                text: @tr("Key blob (only needed for GTA V Enhanced)");
                font-weight: 600;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: Theme.space-s;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.setup-magic-path;
                    accessible-label: @tr("Key blob");
                    placeholder-text: @tr("Path to magic.dat");
                }
                Button {
                    text: @tr("Browse…");
                    clicked => { root.setup-browse-magic(); }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-raised;
            border-radius: Theme.radius;
            Text {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                text: root.setup-log;
                wrap: word-wrap;
                font-family: root.mono-font;
                font-size: 12px;
                color: Theme.text;
            }
        }
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            if root.setup-running: Spinner {
                width: 24px;
                indeterminate: true;
            }
            if root.setup-can-cancel: Button {
                text: @tr("Close");
                enabled: !root.setup-running;
                clicked => { root.setup-visible = false; }
            }
            Button {
                text: @tr("Derive keys");
                primary: true;
                enabled: !root.setup-running && root.setup-game-dir != "";
                clicked => { root.setup-run(); }
            }
        }
    }
}

// Separate window showing a model (orbit) or an image; opened by double-click.
export component ViewerWindow inherits Window {
    title: root.heading + " — OpenRAGE";
    icon: @image-url("logo.svg");
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 480px;
    min-height: 360px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    in-out property <int> theme-mode;
    in property <string> heading;
    in property <string> path;
    in property <string> icon-name;
    in property <color> tint;
    in property <image> image;
    in property <bool> model-mode;
    in property <[GizmoAxis]> gizmo;
    in property <[InfoRow]> rows;
    in property <string> mono-font: "monospace";
    in-out property <bool> show-info: true;
    // First-person camera (WASD + mouse) instead of orbiting.
    in property <bool> fly-mode;
    in property <[PartRow]> parts;
    in property <[MaterialRow]> materials;
    // RDR2 peds: the outfits to choose from (empty for other models).
    in property <[string]> outfits;
    in-out property <int> outfit-index;
    in property <string> outfit-status;
    // Animation: whether the model can be animated, dictionaries found by the
    // search, the opened dictionary's clips and the player state.
    in property <bool> has-skeleton;
    in property <[ClipRow]> anim-results;
    in property <string> anim-dictionary;
    in property <[ClipRow]> anim-clips;
    in property <int> anim-clip: -1;
    in property <bool> anim-playing;
    in property <float> anim-position;
    in property <string> anim-time;
    in property <string> anim-status;
    in-out property <int> anim-speed-index: 2;
    in-out property <bool> anim-loop: true;
    in-out property <int> panel-tab;
    property <int> editing-material: -1;
    out property <length> area-width: area.width;
    out property <length> area-height: area.height;

    callback orbit(length, length);
    callback zoom(float);
    callback resized();
    callback reset-view();
    callback look-along(int);
    callback export-gltf();
    callback save-png();
    callback close-viewer();
    callback copy-path();
    callback toggle-fly();
    callback key-down(string, bool);
    callback key-up(string, bool);
    callback focus-lost();
    callback part-toggled(int, bool);
    callback all-parts(bool);
    callback outfit-selected(int);
    callback material-visible(int, bool);
    callback material-color(int, color);
    callback material-hex(int, string);
    callback material-reset(int);
    callback anim-search(string);
    callback anim-open(int);
    callback anim-select(int);
    callback anim-toggle();
    callback anim-seek(float);
    callback anim-speed(int);

    changed area-width => { root.resized(); }
    changed area-height => { root.resized(); }
    changed theme-mode => { root.apply-theme(); }
    init => {
        root.apply-theme();
        scope.focus();
    }

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    scope := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close-viewer();
            } else if (e.text == "i" || e.text == "I") {
                root.show-info = !root.show-info;
            } else {
                root.key-down(e.text, e.modifiers.shift);
            }
            return accept;
        }
        key-released(e) => {
            root.key-up(e.text, e.modifiers.shift);
            return accept;
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.focus-lost();
            }
        }
        VerticalLayout {
            Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding: Theme.space-s;
                    padding-left: Theme.space-l;
                    spacing: Theme.space-s;
                    FormatIcon {
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        name: root.icon-name;
                        tint: root.tint;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.heading;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            overflow: elide;
                            color: Theme.text;
                        }
                        Text {
                            text: root.path;
                            font-family: root.mono-font;
                            font-size: Theme.font-small;
                            overflow: elide;
                            color: Theme.text-muted;
                        }
                    }
                    if root.model-mode: Button {
                        text: @tr("Fly (F)");
                        checkable: true;
                        checked: root.fly-mode;
                        clicked => {
                            self.checked = root.fly-mode;
                            root.toggle-fly();
                            scope.focus();
                        }
                    }
                    if root.model-mode: Button {
                        text: @tr("Reset view");
                        clicked => { root.reset-view(); }
                    }
                    if root.model-mode: Button {
                        text: @tr("Export glTF…");
                        icon: @image-url("icons/export.svg");
                        colorize-icon: true;
                        clicked => { root.export-gltf(); }
                    }
                    if !root.model-mode: Button {
                        text: @tr("Save PNG…");
                        icon: @image-url("icons/image.svg");
                        colorize-icon: true;
                        clicked => { root.save-png(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/data.svg");
                        label: @tr("Show details (I)");
                        active: root.show-info;
                        clicked => { root.show-info = !root.show-info; }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                vertical-stretch: 1;
                area := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.surface-raised;
                    clip: true;
                    Image {
                        x: Theme.space-l;
                        y: Theme.space-l;
                        width: parent.width - 2 * Theme.space-l;
                        height: parent.height - 2 * Theme.space-l;
                        source: root.image;
                        image-fit: contain;
                        image-rendering: root.model-mode ? smooth : pixelated;
                        accessible-role: AccessibleRole.image;
                        accessible-label: root.heading;
                    }
                    if root.model-mode: ModelControls {
                        orbit(dx, dy) => { root.orbit(dx, dy); }
                        zoom(d) => { root.zoom(d); }
                        double-clicked => { root.reset-view(); }
                        pressed-down => { scope.focus(); }
                    }
                    if root.model-mode: AxisGizmo {
                        x: parent.width - self.width - Theme.space-m;
                        y: parent.height - self.height - Theme.space-m;
                        width: 96px;
                        height: 96px;
                        border-radius: 48px;
                        axes: root.gizmo;
                        pick(i) => { root.look-along(i); }
                    }
                    Text {
                        x: Theme.space-m;
                        y: parent.height - self.height - Theme.space-s;
                        text: !root.model-mode ? @tr("Esc closes")
                            : root.fly-mode ? @tr("W A S D move · Q E down/up · Shift faster · drag to look · F orbits · Esc closes")
                            : @tr("Drag to rotate · scroll to zoom · F flies · R or double-click resets · Esc closes");
                        font-size: Theme.font-small;
                        color: Theme.text-faint;
                    }
                    // Last, so it is on top; left clicks and drags pass through to the controls.
                    ContextMenuArea {
                        Menu {
                            if root.model-mode: MenuItem {
                                title: @tr("Reset view");
                                icon: @image-url("icons/menu/expand.svg");
                                activated => { root.reset-view(); }
                            }
                            if root.model-mode: MenuItem {
                                title: @tr("View from the front");
                                activated => { root.look-along(0); }
                            }
                            if root.model-mode: MenuItem {
                                title: @tr("View from the side");
                                activated => { root.look-along(1); }
                            }
                            if root.model-mode: MenuItem {
                                title: @tr("View from above");
                                activated => { root.look-along(2); }
                            }
                            if root.model-mode: MenuItem {
                                title: root.fly-mode ? @tr("Orbit camera") : @tr("Fly camera");
                                activated => {
                                    root.toggle-fly();
                                    scope.focus();
                                }
                            }
                            if root.model-mode: MenuSeparator { }
                            if root.model-mode: MenuItem {
                                title: @tr("Export glTF…");
                                icon: @image-url("icons/menu/export.svg");
                                activated => { root.export-gltf(); }
                            }
                            if !root.model-mode: MenuItem {
                                title: @tr("Save PNG…");
                                icon: @image-url("icons/menu/image.svg");
                                activated => { root.save-png(); }
                            }
                            MenuItem {
                                title: root.show-info ? @tr("Hide details") : @tr("Show details");
                                activated => { root.show-info = !root.show-info; }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Copy path");
                                icon: @image-url("icons/menu/copy.svg");
                                activated => { root.copy-path(); }
                            }
                            MenuItem {
                                title: @tr("Close");
                                activated => { root.close-viewer(); }
                            }
                        }
                    }
                }
                if root.show-info: Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                if root.show-info: Rectangle {
                    width: 320px;
                    background: Theme.surface;
                    TabWidget {
                        current-index <=> root.panel-tab;
                        Tab {
                            title: @tr("Details");
                            VerticalLayout {
                                padding: Theme.space-l;
                                spacing: Theme.space-s;
                                alignment: start;
                                for r in root.rows: HorizontalLayout {
                                    spacing: Theme.space-m;
                                    if r.key != "": Text {
                                        width: 100px;
                                        text: r.key;
                                        font-size: Theme.font-small;
                                        color: Theme.text-muted;
                                        overflow: elide;
                                    }
                                    InfoValue {
                                        horizontal-stretch: 1;
                                        text: r.value;
                                        color: r.key == "" ? Theme.text-muted : Theme.text;
                                        font-size: r.key == "" ? Theme.font-small : Theme.font-body;
                                    }
                                }
                            }
                        }
                        Tab {
                            title: @tr("Parts");
                            VerticalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-s;
                                if root.outfits.length > 0: HorizontalLayout {
                                    spacing: Theme.space-s;
                                    Text {
                                        text: @tr("Outfit");
                                        vertical-alignment: center;
                                        color: Theme.text-muted;
                                    }
                                    ComboBox {
                                        horizontal-stretch: 1;
                                        model: root.outfits;
                                        current-index <=> root.outfit-index;
                                        selected => { root.outfit-selected(self.current-index); }
                                    }
                                }
                                if root.outfit-status != "": Text {
                                    text: root.outfit-status;
                                    wrap: word-wrap;
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-s;
                                    alignment: end;
                                    Button {
                                        text: @tr("Show all");
                                        clicked => { root.all-parts(true); }
                                    }
                                    Button {
                                        text: @tr("Hide all");
                                        clicked => { root.all-parts(false); }
                                    }
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for p[i] in root.parts: Rectangle {
                                        height: 30px;
                                        border-radius: Theme.radius-s;
                                        background: row-ta.has-hover ? Theme.hover : transparent;
                                        row-ta := TouchArea {
                                            clicked => { root.part-toggled(i, !p.visible); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-s + p.level * 22px;
                                            padding-right: Theme.space-s;
                                            spacing: Theme.space-s;
                                            CheckBox {
                                                checked: p.visible;
                                                toggled => { root.part-toggled(i, self.checked); }
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: p.name;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                font-weight: p.count > 0 ? 600 : 400;
                                                color: Theme.text;
                                            }
                                            if p.count > 0: Text {
                                                text: p.count;
                                                vertical-alignment: center;
                                                font-size: Theme.font-small;
                                                color: Theme.text-faint;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Tab {
                            title: @tr("Materials");
                            VerticalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-s;
                                Text {
                                    text: @tr("Click a colour to paint a material; untick to hide it.");
                                    wrap: word-wrap;
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for m[i] in root.materials: Rectangle {
                                        height: 34px;
                                        HorizontalLayout {
                                            padding-left: Theme.space-s;
                                            padding-right: Theme.space-s;
                                            spacing: Theme.space-s;
                                            CheckBox {
                                                checked: m.visible;
                                                toggled => { root.material-visible(i, self.checked); }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text {
                                                    text: m.label;
                                                    overflow: elide;
                                                    color: Theme.text;
                                                }
                                                if m.paint || m.textured: Text {
                                                    text: m.paint ? @tr("paint") : @tr("textured");
                                                    font-size: Theme.font-small;
                                                    color: Theme.text-faint;
                                                }
                                            }
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 36px;
                                                height: 22px;
                                                border-radius: Theme.radius-s;
                                                border-width: 1px;
                                                border-color: swatch-ta.has-hover ? Theme.text : Theme.border;
                                                background: m.color;
                                                accessible-role: button;
                                                accessible-label: @tr("Colour of {}", m.label);
                                                swatch-ta := TouchArea {
                                                    clicked => {
                                                        root.editing-material = i;
                                                        color-popup.show();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Tab {
                            title: @tr("Animation");
                            VerticalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-s;
                                if !root.has-skeleton: Text {
                                    text: @tr("This model has no skeleton to animate. Peds (.ydd with a .yft next to it) and other skinned models can be animated.");
                                    wrap: word-wrap;
                                    color: Theme.text-muted;
                                }
                                if root.has-skeleton: LineEdit {
                                    placeholder-text: @tr("Find clip dictionaries, e.g. move_m@generic");
                                    accepted(text) => { root.anim-search(text); }
                                }
                                if root.has-skeleton && root.anim-dictionary == "": ListView {
                                    vertical-stretch: 1;
                                    for r[i] in root.anim-results: Rectangle {
                                        height: 40px;
                                        border-radius: Theme.radius-s;
                                        background: res-ta.has-hover ? Theme.hover : transparent;
                                        res-ta := TouchArea {
                                            clicked => { root.anim-open(i); }
                                        }
                                        VerticalLayout {
                                            padding-left: Theme.space-s;
                                            alignment: center;
                                            Text {
                                                text: r.name;
                                                overflow: elide;
                                                color: Theme.text;
                                            }
                                            Text {
                                                text: r.info;
                                                font-size: Theme.font-small;
                                                overflow: elide;
                                                color: Theme.text-faint;
                                            }
                                        }
                                    }
                                }
                                if root.anim-dictionary != "": HorizontalLayout {
                                    spacing: Theme.space-s;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.anim-dictionary;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        color: Theme.text;
                                    }
                                    Button {
                                        text: @tr("Other…");
                                        clicked => { root.anim-open(-1); }
                                    }
                                }
                                if root.anim-dictionary != "": ListView {
                                    vertical-stretch: 1;
                                    for c[i] in root.anim-clips: Rectangle {
                                        height: 28px;
                                        border-radius: Theme.radius-s;
                                        background: i == root.anim-clip ? Theme.accent-subtle : clip-ta.has-hover ? Theme.hover : transparent;
                                        clip-ta := TouchArea {
                                            clicked => { root.anim-select(i); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-s;
                                            padding-right: Theme.space-s;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: c.name;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                font-weight: i == root.anim-clip ? 600 : 400;
                                                color: Theme.text;
                                            }
                                            Text {
                                                text: c.info;
                                                vertical-alignment: center;
                                                font-size: Theme.font-small;
                                                color: Theme.text-faint;
                                            }
                                        }
                                    }
                                }
                                if root.anim-clip >= 0: Rectangle {
                                    border-radius: Theme.radius;
                                    background: Theme.background;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: Theme.space-s;
                                        spacing: Theme.space-xs;
                                        HorizontalLayout {
                                            spacing: Theme.space-s;
                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 17px;
                                                background: anim-play-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                                                accessible-role: button;
                                                accessible-label: root.anim-playing ? @tr("Pause") : @tr("Play");
                                                accessible-action-default => { root.anim-toggle(); }
                                                Image {
                                                    width: 16px;
                                                    height: 16px;
                                                    x: (parent.width - self.width) / 2 + (root.anim-playing ? 0px : 1.5px);
                                                    y: (parent.height - self.height) / 2;
                                                    source: root.anim-playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                                    colorize: Palette.accent-foreground;
                                                }
                                                anim-play-ta := TouchArea {
                                                    clicked => { root.anim-toggle(); }
                                                }
                                            }
                                            Slider {
                                                horizontal-stretch: 1;
                                                minimum: 0;
                                                maximum: 1;
                                                value: root.anim-position;
                                                changed(v) => { root.anim-seek(v); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.space-s;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.anim-time;
                                                vertical-alignment: center;
                                                font-size: Theme.font-small;
                                                color: Theme.text-muted;
                                            }
                                            ComboBox {
                                                width: 90px;
                                                model: ["0.25×", "0.5×", "1×", "2×"];
                                                current-index <=> root.anim-speed-index;
                                                selected => { root.anim-speed(self.current-index); }
                                            }
                                            CheckBox {
                                                text: @tr("Loop");
                                                checked <=> root.anim-loop;
                                            }
                                        }
                                    }
                                }
                                if root.anim-status != "": Text {
                                    text: root.anim-status;
                                    wrap: word-wrap;
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    color-popup := PopupWindow {
        x: root.width - 340px;
        y: 110px;
        width: 300px;
        Rectangle {
            background: Theme.background;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: Theme.space-m;
                spacing: Theme.space-s;
                Text {
                    text: root.editing-material >= 0 && root.editing-material < root.materials.length ? root.materials[root.editing-material].label : "";
                    font-weight: 600;
                    color: Theme.text;
                }
                GridLayout {
                    spacing: 6px;
                    for c[i] in [#0d1116, #2b2d33, #8c9095, #e8e8e8, #b5121b, #f0362a, #f78616, #f2c40c, #6fb52c, #14632f, #1e4fa1, #4ba7e3, #5b2580, #e47fae, #5c4433, #b8914d]: Rectangle {
                        col: Math.mod(i, 8);
                        row: floor(i / 8);
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-s;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: c;
                        TouchArea {
                            clicked => {
                                root.material-color(root.editing-material, c);
                                color-popup.close();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    hex := LineEdit {
                        placeholder-text: "#RRGGBB";
                        accepted(text) => {
                            root.material-hex(root.editing-material, text);
                            color-popup.close();
                        }
                    }
                    Button {
                        text: @tr("Reset");
                        clicked => {
                            root.material-reset(root.editing-material);
                            color-popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Text editor window: read-only until edit mode is unlocked in the main window;
// saving writes into the mods folder like every other change.
export component EditorWindow inherits Window {
    /// The folder changes go to: `mods`, or `update` for GTA IV.
    in property <string> overlay-folder: "mods";
    /// Changes go into the game's own files (GTA IV, when chosen).
    in property <bool> write-in-game;
    title: (root.modified ? "• " : "") + root.heading + " — OpenRAGE";
    icon: @image-url("logo.svg");
    preferred-width: 980px;
    preferred-height: 760px;
    min-width: 480px;
    min-height: 320px;
    background: Theme.background;
    default-font-size: Theme.font-body;
    default-font-family: root.mono-font;

    in-out property <int> theme-mode;
    in property <string> heading;
    in property <string> path;
    in property <string> mono-font: "monospace";
    in-out property <string> text;
    // Edit mode of the main window.
    in property <bool> editable;
    // Why it cannot be saved at all (e.g. not UTF-8), empty if it can.
    in property <string> locked-reason;
    in-out property <bool> modified;
    in property <bool> saving;
    in property <string> status;
    in-out property <bool> confirm-close;
    in-out property <bool> wrap: false;
    in property <bool> has-tabs;
    in-out property <bool> tabs-shown;

    callback save();
    // Unlocking or locking edit mode (applies to the main window and all editors).
    callback set-edit-mode(bool);
    in-out property <bool> unlock-visible;
    callback discard-and-close();
    callback reload();
    callback toggle-tabs();
    callback copy-path();

    changed theme-mode => { root.apply-theme(); }

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    property <bool> can-save: root.editable && root.locked-reason == "" && root.modified && !root.saving;

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Control + S);
            activated => {
                if (root.can-save) {
                    root.save();
                }
            }
        }
        VerticalLayout {
            Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding: Theme.space-s;
                    padding-left: Theme.space-l;
                    spacing: Theme.space-s;
                    FormatIcon {
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        name: "text";
                        tint: #7c8592;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: (root.modified ? "• " : "") + root.heading;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            overflow: elide;
                            color: Theme.text;
                        }
                        Text {
                            text: root.path;
                            font-family: root.mono-font;
                            font-size: Theme.font-small;
                            overflow: elide;
                            color: Theme.text-muted;
                        }
                    }
                    if root.has-tabs: Button {
                        text: root.tabs-shown ? @tr("Hide tabs") : @tr("Show tabs");
                        clicked => { root.toggle-tabs(); }
                    }
                    Button {
                        text: root.wrap ? @tr("No wrap") : @tr("Wrap lines");
                        clicked => { root.wrap = !root.wrap; }
                    }
                    Button {
                        text: @tr("Reload");
                        enabled: !root.saving;
                        clicked => { root.reload(); }
                    }
                    Button {
                        text: @tr("Save (Ctrl+S)");
                        icon: @image-url("icons/import.svg");
                        colorize-icon: true;
                        primary: true;
                        enabled: root.can-save;
                        clicked => { root.save(); }
                    }
                }
            }
            if root.editable && root.locked-reason == "": EditModeStrip {
                folder: root.overlay-folder;
                in-game: root.write-in-game;
                lock => { root.set-edit-mode(false); }
            }
            // Protection banner
            if !root.editable || root.locked-reason != "": Rectangle {
                background: Theme.accent-subtle;
                HorizontalLayout {
                    padding: Theme.space-s;
                    padding-left: Theme.space-l;
                    spacing: Theme.space-s;
                    Image {
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/lock.svg");
                        colorize: Theme.text-muted;
                    }
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        color: Theme.text;
                        text: root.locked-reason != "" ? root.locked-reason
                            : @tr("Read-only. Unlock editing to change this file; saving writes it into the {} folder and can be undone.", root.overlay-folder);
                    }
                    if root.locked-reason == "": Button {
                        text: @tr("Unlock editing…");
                        icon: @image-url("icons/unlock.svg");
                        colorize-icon: true;
                        clicked => { root.unlock-visible = true; }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Rectangle {
                vertical-stretch: 1;
                editor := TextEdit {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    read-only: !root.editable || root.locked-reason != "" || root.saving;
                    font-size: 13px;
                    wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
                    edited => { root.modified = true; }
                }
                // On top of the TextEdit, replacing its own menu (cut, copy, paste,
                // select all) with one that also has the editor's actions.
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Cut");
                            enabled: !editor.read-only;
                            activated => { editor.cut(); }
                        }
                        MenuItem {
                            title: @tr("Copy");
                            icon: @image-url("icons/menu/copy.svg");
                            activated => { editor.copy(); }
                        }
                        MenuItem {
                            title: @tr("Paste");
                            enabled: !editor.read-only;
                            activated => { editor.paste(); }
                        }
                        MenuItem {
                            title: @tr("Select all");
                            activated => { editor.select-all(); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Save");
                            icon: @image-url("icons/menu/import.svg");
                            enabled: root.can-save;
                            activated => { root.save(); }
                        }
                        MenuItem {
                            title: @tr("Reload");
                            icon: @image-url("icons/menu/undo.svg");
                            enabled: !root.saving;
                            activated => { root.reload(); }
                        }
                        if !root.editable && root.locked-reason == "": MenuItem {
                            title: @tr("Unlock editing…");
                            icon: @image-url("icons/menu/unlock.svg");
                            activated => { root.unlock-visible = true; }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: root.wrap ? @tr("No wrap") : @tr("Wrap lines");
                            activated => { root.wrap = !root.wrap; }
                        }
                        if root.has-tabs: MenuItem {
                            title: root.tabs-shown ? @tr("Hide tabs") : @tr("Show tabs");
                            activated => { root.toggle-tabs(); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Copy path");
                            icon: @image-url("icons/menu/copy.svg");
                            activated => { root.copy-path(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.space-l;
                    padding-right: Theme.space-l;
                    height: 28px;
                    Text {
                        text: root.status;
                        vertical-alignment: center;
                        font-size: Theme.font-small;
                        overflow: elide;
                        color: Theme.text-muted;
                    }
                }
            }
        }
    }

    if root.unlock-visible: UnlockDialog {
        folder: root.overlay-folder;
        in-game: root.write-in-game;
        width: root.width;
        height: root.height;
        confirm => {
            root.unlock-visible = false;
            root.set-edit-mode(true);
        }
        cancel => { root.unlock-visible = false; }
    }

    if root.confirm-close: Dialog {
        title: @tr("Unsaved changes");
        panel-width: 440px;
        panel-height: 190px;
        close => { root.confirm-close = false; }
        Text {
            text: @tr("Save the changes to {} before closing?", root.heading);
            wrap: word-wrap;
            color: Theme.text;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-s;
            Button {
                text: @tr("Discard");
                clicked => { root.discard-and-close(); }
            }
            Button {
                text: @tr("Cancel");
                clicked => { root.confirm-close = false; }
            }
            Button {
                text: @tr("Save");
                primary: true;
                enabled: root.editable && root.locked-reason == "";
                clicked => {
                    root.confirm-close = false;
                    root.save();
                }
            }
        }
    }

    init => {
        root.apply-theme();
        editor.focus();
    }

    // Puts the cursor at the start and scrolls back to the top left; the text
    // field scrolls to the cursor while it is still being laid out.
    public function reset-view() {
        editor.set-selection-offsets(0, 0);
        editor.focus();
    }
}

// Metadata (.ymap, .ytyp, .ymt, …) in a readable form: a structure tree with
// the selected node's fields, and the XML with syntax colors.
export component XmlWindow inherits Window {
    title: root.heading + " — OpenRAGE";
    icon: @image-url("logo.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 600px;
    min-height: 360px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    in-out property <int> theme-mode;
    in property <string> mono-font: "monospace";
    in property <string> heading;
    in property <string> path;
    in property <string> summary;
    in-out property <int> tab;
    in property <[XmlNodeRow]> nodes;
    in-out property <int> selected-node: -1;
    in property <string> node-title;
    in property <[InfoRow]> fields;
    in property <[XmlLine]> lines;
    in property <string> status;
    // Cutscenes (.cut): a tab with the cast.
    in property <bool> is-cutscene;
    in property <string> cutscene-summary;
    in property <[CastRow]> cast;
    callback play-actor(int);
    callback play-scene();
    // Map files (.ymap): show their objects in a 3D scene.
    in property <bool> is-map;
    callback show-map();
    in-out property <string> filter;
    property <length> tree-width: 380px;

    callback toggle(int);
    callback select(int);
    callback filter-edited(string);
    callback export-xml();
    callback open-text();
    // The file is XML text (editable as such), not converted from a binary format.
    in property <bool> plain-text;
    callback expand-all(bool);
    // Context menus: copy text, act on a tree row or an XML line.
    callback copy-text(string);
    callback node-action(int, string);
    callback line-action(int, string);
    // An XML line marked by "Show in XML" (0-based), or -1.
    in-out property <int> marked-line: -1;

    // Switches to the XML tab and scrolls so that `line` (0-based) is near the top.
    public function show-line(line: int) {
        root.tab = 1;
        root.marked-line = line;
        xml-list.content-y = -max(0px, (line - 3) * 18px);
    }

    changed theme-mode => { root.apply-theme(); }
    init => { root.apply-theme(); }

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    function span-color(kind: int) -> color {
        if (kind == 1) { return Theme.syntax-tag; }
        if (kind == 2) { return Theme.syntax-attribute; }
        if (kind == 3) { return Theme.syntax-value; }
        if (kind == 0) { return Theme.text-faint; }
        return Theme.text;
    }

    VerticalLayout {
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding: Theme.space-m;
                padding-left: Theme.space-l;
                spacing: Theme.space-s;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 20px;
                    source: @image-url("icons/data.svg");
                    colorize: Theme.success;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.heading;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        overflow: elide;
                        color: Theme.text;
                    }
                    Text {
                        text: root.summary;
                        font-size: Theme.font-small;
                        overflow: elide;
                        color: Theme.text-muted;
                    }
                }
                if root.is-map: Button {
                    text: @tr("Show in 3D");
                    icon: @image-url("icons/map.svg");
                    colorize-icon: true;
                    primary: true;
                    clicked => { root.show-map(); }
                }
                Button {
                    text: root.plain-text ? @tr("Edit as text") : @tr("Open as text");
                    icon: @image-url("icons/text.svg");
                    colorize-icon: true;
                    clicked => { root.open-text(); }
                }
                Button {
                    text: @tr("Export XML…");
                    icon: @image-url("icons/export.svg");
                    colorize-icon: true;
                    clicked => { root.export-xml(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        TabWidget {
            vertical-stretch: 1;
            current-index <=> root.tab;
            Tab {
                title: @tr("Structure");
                HorizontalLayout {
                    // Tree
                    VerticalLayout {
                        width: root.tree-width;
                        padding: Theme.space-s;
                        spacing: Theme.space-s;
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: @tr("Filter names and values");
                                text <=> root.filter;
                                edited(t) => { root.filter-edited(t); }
                            }
                            Button {
                                text: @tr("Expand all");
                                clicked => { root.expand-all(true); }
                            }
                            Button {
                                text: @tr("Collapse");
                                clicked => { root.expand-all(false); }
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for n[i] in root.nodes: Rectangle {
                                height: Theme.row-height;
                                border-radius: Theme.radius-s;
                                background: i == root.selected-node ? Theme.selection : row-ta.has-hover ? Theme.hover : transparent;
                                row-ta := TouchArea {
                                    clicked => { root.select(i); }
                                    double-clicked => {
                                        if (n.expandable) {
                                            root.toggle(i);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.space-s + n.depth * 16px;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-xs;
                                    Rectangle {
                                        width: 16px;
                                        Text {
                                            text: n.expandable ? (n.expanded ? "▾" : "▸") : "";
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                            color: i == root.selected-node ? Theme.selection-text : Theme.text-muted;
                                        }
                                        TouchArea {
                                            clicked => { root.toggle(i); }
                                        }
                                    }
                                    Text {
                                        text: n.label;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        font-weight: n.hit ? 600 : 400;
                                        color: i == root.selected-node ? Theme.selection-text : Theme.text;
                                    }
                                }
                                // Last, so it is on top: a TouchArea inside would take the right click too.
                                ContextMenuArea {
                                    Menu {
                                        if n.expandable: MenuItem {
                                            title: n.expanded ? @tr("Collapse") : @tr("Expand");
                                            icon: @image-url("icons/menu/chevrons.svg");
                                            activated => { root.toggle(i); }
                                        }
                                        MenuItem {
                                            title: @tr("Expand all");
                                            icon: @image-url("icons/menu/expand.svg");
                                            activated => { root.expand-all(true); }
                                        }
                                        MenuItem {
                                            title: @tr("Collapse all");
                                            icon: @image-url("icons/menu/chevrons.svg");
                                            activated => { root.expand-all(false); }
                                        }
                                        MenuSeparator { }
                                        MenuItem {
                                            title: @tr("Copy name");
                                            icon: @image-url("icons/menu/copy.svg");
                                            activated => { root.copy-text(n.label); }
                                        }
                                        MenuItem {
                                            title: @tr("Copy values");
                                            icon: @image-url("icons/menu/copy.svg");
                                            activated => { root.node-action(i, "copy-values"); }
                                        }
                                        MenuItem {
                                            title: @tr("Copy as XML");
                                            icon: @image-url("icons/menu/copy.svg");
                                            activated => { root.node-action(i, "copy-xml"); }
                                        }
                                        MenuItem {
                                            title: @tr("Show in XML");
                                            icon: @image-url("icons/menu/text.svg");
                                            activated => { root.node-action(i, "show-xml"); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Splitter {
                        dragged(d) => { root.tree-width = max(200px, min(root.width - 300px, root.tree-width + d)); }
                    }
                    // Fields of the selected node
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding: Theme.space-l;
                        spacing: Theme.space-s;
                        Text {
                            text: root.node-title;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            overflow: elide;
                            color: Theme.text;
                        }
                        if root.fields.length == 0: Text {
                            text: @tr("No values of its own — open it in the tree to see what it contains.");
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for f[i] in root.fields: Rectangle {
                                height: max(Theme.row-height, value-text.preferred-height + 8px);
                                background: Math.mod(i, 2) == 1 ? Theme.stripe : transparent;
                                HorizontalLayout {
                                    padding-left: Theme.space-s;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-m;
                                    Text {
                                        width: 200px;
                                        text: f.key;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        color: Theme.text-muted;
                                    }
                                    value-text := InfoValue {
                                        horizontal-stretch: 1;
                                        text: f.value;
                                        vertical-alignment: center;
                                        color: Theme.text;
                                    }
                                }
                                ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: @tr("Copy value");
                                            icon: @image-url("icons/menu/copy.svg");
                                            activated => { root.copy-text(f.value); }
                                        }
                                        MenuItem {
                                            title: @tr("Copy name");
                                            icon: @image-url("icons/menu/copy.svg");
                                            activated => { root.copy-text(f.key); }
                                        }
                                        MenuItem {
                                            title: @tr("Copy name and value");
                                            icon: @image-url("icons/menu/copy.svg");
                                            activated => { root.copy-text(f.key + ": " + f.value); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Tab {
                title: @tr("XML");
                xml-list := ListView {
                    for l[i] in root.lines: Rectangle {
                        height: 18px;
                        background: i == root.marked-line ? Theme.accent-subtle : transparent;
                        HorizontalLayout {
                            spacing: Theme.space-m;
                            Text {
                                width: 56px;
                                text: l.number;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                font-family: root.mono-font;
                                font-size: 12px;
                                color: Theme.text-faint;
                            }
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                alignment: start;
                                for s in l.spans: Text {
                                    text: s.text;
                                    vertical-alignment: center;
                                    font-family: root.mono-font;
                                    font-size: 12px;
                                    color: root.span-color(s.kind);
                                }
                            }
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: @tr("Copy line");
                                    icon: @image-url("icons/menu/copy.svg");
                                    activated => { root.line-action(i, "copy"); }
                                }
                                MenuItem {
                                    title: @tr("Copy all XML");
                                    icon: @image-url("icons/menu/copy.svg");
                                    activated => { root.line-action(i, "copy-all"); }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: root.plain-text ? @tr("Edit as text") : @tr("Open as text");
                                    icon: @image-url("icons/menu/text.svg");
                                    activated => { root.open-text(); }
                                }
                                MenuItem {
                                    title: @tr("Export XML…");
                                    icon: @image-url("icons/menu/export.svg");
                                    activated => { root.export-xml(); }
                                }
                            }
                        }
                    }
                }
            }
            Tab {
                title: root.is-cutscene ? @tr("Cutscene") : @tr("Overview");
                VerticalLayout {
                    padding: Theme.space-l;
                    spacing: Theme.space-s;
                    HorizontalLayout {
                        spacing: Theme.space-m;
                        Text {
                            horizontal-stretch: 1;
                            text: root.cutscene-summary;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            color: Theme.text-muted;
                        }
                        if root.is-cutscene: Button {
                            text: @tr("Play whole cutscene");
                            icon: @image-url("icons/play.svg");
                            colorize-icon: true;
                            primary: true;
                            clicked => { root.play-scene(); }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for a[i] in root.cast: Rectangle {
                            height: 36px;
                            background: Math.mod(i, 2) == 1 ? Theme.stripe : transparent;
                            HorizontalLayout {
                                padding-left: Theme.space-s;
                                padding-right: Theme.space-s;
                                spacing: Theme.space-m;
                                Text {
                                    width: 90px;
                                    text: a.kind;
                                    vertical-alignment: center;
                                    color: Theme.text-muted;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: a.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: Theme.text;
                                }
                                if a.playable: Rectangle {
                                    width: 150px;
                                    Button {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        text: @tr("Play animation");
                                        icon: @image-url("icons/play.svg");
                                        colorize-icon: true;
                                        clicked => { root.play-actor(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                height: 28px;
                Text {
                    text: root.status;
                    vertical-alignment: center;
                    font-size: Theme.font-small;
                    overflow: elide;
                    color: Theme.text-muted;
                }
            }
        }
    }
}

// A whole cutscene in one scene: every actor with its animation, seen
// through the cutscene camera or a free camera.
export component SceneWindow inherits Window {
    title: root.heading + " — OpenRAGE";
    icon: @image-url("logo.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 600px;
    min-height: 360px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    in-out property <int> theme-mode;
    in property <string> heading;
    in property <string> path;
    in property <image> frame;
    in property <bool> loading: true;
    // What is loading (cast while `loading`, then the surroundings) and how
    // far: 0..1, or below 0 when the amount is not known.
    in property <string> load-text;
    in property <float> load-progress: -1;
    in property <bool> playing;
    in property <float> duration: 1;
    in-out property <float> time;
    in property <string> time-text;
    in property <bool> cut-camera: true;
    in property <bool> has-camera;
    in property <string> status;
    // The map around the scene: 0 not loaded yet, 1 shown, 2 hidden.
    in property <int> surroundings;
    callback toggle-surroundings();
    in property <bool> has-lights;
    in property <bool> lights-on;
    callback toggle-lights();
    // Cutscenes have a timeline; a map scene has none but a list of its objects.
    in property <bool> timeline: true;
    in property <[PartRow]> objects;
    callback object-toggled(int, bool);
    callback all-objects(bool);
    in property <bool> can-export;
    callback export-gltf();
    out property <length> area-width: area.width;
    out property <length> area-height: area.height;

    callback toggle-play();
    callback seek(float);
    callback toggle-camera();
    callback rotate(length, length);
    callback zoom(float);
    callback resized();

    changed theme-mode => { root.apply-theme(); }
    changed area-width => { root.resized(); }
    changed area-height => { root.resized(); }
    init => { root.apply-theme(); }

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    VerticalLayout {
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding: Theme.space-m;
                padding-left: Theme.space-l;
                spacing: Theme.space-s;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 20px;
                    source: root.timeline ? @image-url("icons/anim.svg") : @image-url("icons/map.svg");
                    colorize: Theme.accent;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.heading;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        overflow: elide;
                        color: Theme.text;
                    }
                    Text {
                        text: root.path;
                        font-size: Theme.font-small;
                        overflow: elide;
                        color: Theme.text-muted;
                    }
                }
                if root.has-lights: Button {
                    text: root.lights-on ? @tr("Lights off") : @tr("Lights on");
                    clicked => { root.toggle-lights(); }
                }
                if root.surroundings > 0: Button {
                    text: root.surroundings == 1 ? @tr("Hide surroundings") : @tr("Show surroundings");
                    clicked => { root.toggle-surroundings(); }
                }
                if root.has-camera: Button {
                    text: root.cut-camera ? @tr("Free camera") : @tr("Cutscene camera");
                    clicked => { root.toggle-camera(); }
                }
                if root.can-export: Button {
                    text: @tr("Export glTF…");
                    icon: @image-url("icons/export.svg");
                    colorize-icon: true;
                    clicked => { root.export-gltf(); }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            area := Rectangle {
                vertical-stretch: 1;
                background: #000000;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: contain;
                }
                if root.loading: VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-s;
                    HorizontalLayout {
                        alignment: center;
                        Spinner {
                            width: 40px;
                            height: 40px;
                            indeterminate: root.load-progress < 0;
                            progress: max(root.load-progress, 0);
                        }
                    }
                    Text {
                        horizontal-alignment: center;
                        text: root.load-text != "" ? root.load-text : @tr("Loading the cast …");
                        color: #ffffff;
                    }
                }
                // The surroundings load while the scene already plays.
                if !root.loading && root.load-text != "": Rectangle {
                    x: Theme.space-m;
                    y: parent.height - self.height - Theme.space-m;
                    width: row.preferred-width + 2 * Theme.space-s;
                    height: row.preferred-height + 2 * Theme.space-xs;
                    border-radius: 6px;
                    background: #000000b0;
                    row := HorizontalLayout {
                        padding-left: Theme.space-s;
                        padding-right: Theme.space-s;
                        padding-top: Theme.space-xs;
                        padding-bottom: Theme.space-xs;
                        spacing: Theme.space-s;
                        Spinner {
                            width: 18px;
                            height: 18px;
                            indeterminate: root.load-progress < 0;
                            progress: max(root.load-progress, 0);
                        }
                        Text {
                            vertical-alignment: center;
                            text: root.load-text;
                            color: #ffffff;
                            font-size: Theme.font-small;
                        }
                    }
                }
                ta := TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.last-x = self.mouse-x;
                            self.last-y = self.mouse-y;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.rotate(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                            self.last-x = self.mouse-x;
                            self.last-y = self.mouse-y;
                        }
                    }
                    scroll-event(e) => {
                        root.zoom(e.delta-y / 1px);
                        return EventResult.accept;
                    }
                }
            }
            if root.objects.length > 0: Rectangle {
                width: 300px;
                background: Theme.surface;
                VerticalLayout {
                    padding: Theme.space-m;
                    spacing: Theme.space-s;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Objects");
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.text;
                        }
                        Button {
                            text: @tr("Show all");
                            clicked => { root.all-objects(true); }
                        }
                        Button {
                            text: @tr("Hide all");
                            clicked => { root.all-objects(false); }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for o[i] in root.objects: Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-s;
                            background: obj-ta.has-hover ? Theme.hover : transparent;
                            obj-ta := TouchArea {
                                clicked => { root.object-toggled(i, !o.visible); }
                            }
                            HorizontalLayout {
                                padding-left: Theme.space-s;
                                padding-right: Theme.space-s;
                                spacing: Theme.space-s;
                                CheckBox {
                                    checked: o.visible;
                                    toggled => { root.object-toggled(i, self.checked); }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: o.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: Theme.text;
                                }
                                Text {
                                    text: o.count > 1 ? "× " + o.count : "";
                                    vertical-alignment: center;
                                    font-size: Theme.font-small;
                                    color: Theme.text-faint;
                                }
                            }
                        }
                    }
                }
            }
        }
        if root.timeline: Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding: Theme.space-s;
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                spacing: Theme.space-m;
                Rectangle {
                    width: 40px;
                    IconButton {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                        label: root.playing ? @tr("Pause (Space)") : @tr("Play (Space)");
                        clicked => { root.toggle-play(); }
                    }
                }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: root.duration;
                    value: root.time;
                    changed(v) => { root.seek(v); }
                }
                Text {
                    width: 130px;
                    text: root.time-text;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    color: Theme.text-muted;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                height: 28px;
                Text {
                    text: root.status;
                    vertical-alignment: center;
                    font-size: Theme.font-small;
                    overflow: elide;
                    color: Theme.text-muted;
                }
            }
        }
    }
    FocusScope {
        key-pressed(e) => {
            if (e.text == " ") {
                root.toggle-play();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
}

// The change journal in its own window.
export component HistoryWindow inherits Window {
    /// The folder changes go to: `mods`, or `update` for GTA IV.
    in property <string> overlay-folder: "mods";
    /// Changes go into the game's own files (GTA IV, when chosen).
    in property <bool> write-in-game;
    title: @tr("History — OpenRAGE");
    icon: @image-url("logo.svg");
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 300px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    in-out property <int> theme-mode;
    in property <[HistoryRow]> rows;
    in-out property <int> selected: -1;
    in property <bool> busy;
    in property <bool> edit-mode;
    in property <string> status;

    callback undo();
    callback uninstall(string);
    callback show-in-main();
    callback set-edit-mode(bool);
    in-out property <bool> unlock-visible;
    /// Game files changed in place whose originals are kept (GTA IV).
    in property <int> originals;
    callback restore-originals();
    property <bool> confirm-restore;

    changed theme-mode => { root.apply-theme(); }
    init => { root.apply-theme(); }

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    property <string> group: root.selected >= 0 && root.selected < root.rows.length ? root.rows[root.selected].group : "";

    VerticalLayout {
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding: Theme.space-m;
                padding-left: Theme.space-l;
                spacing: Theme.space-s;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: @tr("History");
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: root.write-in-game || root.originals > 0
                            ? @tr("Every change OpenRAGE made to the {} folder and the game files, newest first. Everything can be undone.", root.overlay-folder)
                            : @tr("Every change OpenRAGE made to the {} folder, newest first. Everything can be undone.", root.overlay-folder);
                        font-size: Theme.font-small;
                        overflow: elide;
                        color: Theme.text-muted;
                    }
                }
                Button {
                    text: @tr("Show in main window");
                    clicked => { root.show-in-main(); }
                }
            }
        }
        if !root.edit-mode: Rectangle {
            background: Theme.accent-subtle;
            HorizontalLayout {
                padding: Theme.space-s;
                padding-left: Theme.space-l;
                spacing: Theme.space-s;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: @tr("Read-only. Unlock editing in the main window to undo or uninstall.");
                    color: Theme.text;
                }
                Button {
                    text: @tr("Unlock editing…");
                    icon: @image-url("icons/unlock.svg");
                    colorize-icon: true;
                    clicked => { root.unlock-visible = true; }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            vertical-stretch: 1;
            ListView {
                for r[i] in root.rows: Rectangle {
                    height: 44px;
                    background: i == root.selected ? Theme.accent-subtle : ta.has-hover ? Theme.hover : Math.mod(i, 2) == 1 ? Theme.stripe : transparent;
                    ta := TouchArea {
                        clicked => { root.selected = i; }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-l;
                        padding-right: Theme.space-l;
                        spacing: Theme.space-m;
                        Text {
                            width: 110px;
                            text: r.when;
                            vertical-alignment: center;
                            font-size: Theme.font-small;
                            color: Theme.text-muted;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: r.description;
                                overflow: elide;
                                font-weight: i == 0 ? 600 : 400;
                                color: Theme.text;
                            }
                            Text {
                                text: r.place;
                                font-size: Theme.font-small;
                                overflow: elide;
                                color: Theme.text-faint;
                            }
                        }
                        if r.group != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 22px;
                            border-radius: 11px;
                            background: Theme.accent-subtle;
                            HorizontalLayout {
                                padding-left: Theme.space-s;
                                padding-right: Theme.space-s;
                                Text {
                                    text: r.group;
                                    vertical-alignment: center;
                                    font-size: Theme.font-small;
                                    color: Theme.text;
                                }
                            }
                        }
                    }
                }
            }
            if root.rows.length == 0: Text {
                text: @tr("No changes yet.");
                color: Theme.text-faint;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            background: Theme.surface;
            HorizontalLayout {
                padding: Theme.space-s;
                padding-left: Theme.space-l;
                spacing: Theme.space-s;
                Text {
                    horizontal-stretch: 1;
                    text: root.status;
                    vertical-alignment: center;
                    font-size: Theme.font-small;
                    overflow: elide;
                    color: Theme.text-muted;
                }
                if root.originals > 0: Button {
                    text: @tr("Restore game files ({})", root.originals);
                    icon: @image-url("icons/undo.svg");
                    colorize-icon: true;
                    enabled: root.edit-mode && !root.busy;
                    clicked => { root.confirm-restore = true; }
                }
                Button {
                    text: root.group == "" ? @tr("Uninstall package") : @tr("Uninstall “{}”", root.group);
                    icon: @image-url("icons/remove.svg");
                    colorize-icon: true;
                    enabled: root.group != "" && root.edit-mode && !root.busy;
                    clicked => { root.uninstall(root.group); }
                }
                Button {
                    text: @tr("Undo newest");
                    icon: @image-url("icons/undo.svg");
                    colorize-icon: true;
                    primary: true;
                    enabled: root.rows.length > 0 && root.edit-mode && !root.busy;
                    clicked => { root.undo(); }
                }
            }
        }
    }

    if root.confirm-restore: Dialog {
        width: root.width;
        height: root.height;
        title: @tr("Restore the original game files?");
        panel-width: 480px;
        panel-height: 210px;
        close => { root.confirm-restore = false; }
        Text {
            text: @tr("{} game files changed in place get their original content back. Their changes leave the history and cannot be redone.", root.originals);
            wrap: word-wrap;
            color: Theme.text;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-s;
            Button {
                text: @tr("Cancel");
                clicked => { root.confirm-restore = false; }
            }
            Button {
                text: @tr("Restore");
                primary: true;
                clicked => {
                    root.confirm-restore = false;
                    root.restore-originals();
                }
            }
        }
    }

    if root.unlock-visible: UnlockDialog {
        folder: root.overlay-folder;
        in-game: root.write-in-game;
        width: root.width;
        height: root.height;
        confirm => {
            root.unlock-visible = false;
            root.set-edit-mode(true);
        }
        cancel => { root.unlock-visible = false; }
    }
}
