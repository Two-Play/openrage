// The interface between OpenRAGE and its plugins.
//
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// This file is under MIT OR Apache-2.0 (unlike the rest of OpenRAGE, which is
// GPL-3.0-only), so plugins built against it may use any licence.
//
// The API is not stable before 1.0: a plugin names the version it was built
// for (`api` in plugin.toml) and OpenRAGE refuses plugins for another one.

package openrage:plugin@0.3.0;

interface types {
    /// The game that is open.
    enum game {
        gta5,
        rdr2,
        gta4,
        /// No game is open, or one OpenRAGE does not know.
        other,
    }

    /// A file or folder in a directory listing.
    record dir-entry {
        name: string,
        is-dir: bool,
        /// Size in bytes once read (0 for folders).
        size: u64,
    }

    /// One line of the info panel next to the preview.
    record info {
        key: string,
        value: string,
    }

    /// A node of a tree view. Nodes are listed parents first; `parent` is the
    /// index of the parent node, or none for a top-level node.
    record tree-node {
        parent: option<u32>,
        label: string,
        /// Shown next to the label; may be empty.
        value: string,
    }

    record table {
        columns: list<string>,
        /// Each row has one cell per column.
        rows: list<list<string>>,
    }

    /// An image as 8-bit RGBA pixels, row by row from the top
    /// (`width * height * 4` bytes).
    record image {
        width: u32,
        height: u32,
        rgba: list<u8>,
    }

    /// A material of a 3D model.
    record material {
        name: string,
        /// Name of its colour texture, "" if it has none.
        texture: string,
        /// Colour (RGBA, 0–1) where there is no texture.
        color: tuple<f32, f32, f32, f32>,
        /// The texture's pixels, for models a plugin builds itself.
        /// `load-model` leaves it empty: get textures with `load-texture`.
        image: option<image>,
    }

    /// Triangles of one material, in model space (metres, Z up).
    record mesh {
        /// The part of the model it belongs to (e.g. a wheel); may be empty.
        part: string,
        /// x, y, z per vertex.
        positions: list<f32>,
        /// x, y, z per vertex, or empty.
        normals: list<f32>,
        /// u, v per vertex (v grows downwards, as in DirectX), or empty.
        uvs: list<f32>,
        /// Three vertex indices per triangle.
        indices: list<u32>,
        /// Index into the model's materials.
        material: u32,
    }

    record model {
        meshes: list<mesh>,
        materials: list<material>,
    }

    /// How a file is shown in the preview pane.
    variant view {
        text(string),
        tree(list<tree-node>),
        table(table),
        image(image),
        /// Shown in the 3D view (and exportable as glTF from there).
        model(model),
    }

    record preview {
        info: list<info>,
        view: option<view>,
    }

    /// A file the user picked to run an action on.
    record input {
        /// Its path in the game (as shown in the address bar), or its file
        /// name when it comes from outside the game.
        vpath: string,
        data: list<u8>,
        /// The user chose it from disk because the action asks for files
        /// (`pick` in plugin.toml), e.g. a patch to apply; `vpath` is then
        /// its file name.
        picked: bool,
    }

    /// A file an action produced. OpenRAGE saves it where the user chooses;
    /// `name` may contain `/` for sub-folders but no `..`.
    record output-file {
        name: string,
        data: list<u8>,
    }

    enum level {
        debug,
        info,
        warn,
        error,
    }
}

/// What OpenRAGE offers a plugin.
interface host {
    use types.{game, dir-entry, level, model, image};

    /// The game that is open.
    current-game: func() -> game;

    /// Reads a file of the game (with the changes in `mods/`), by its path
    /// relative to the game folder, e.g. `x64a.rpf/levels/gta5/x.ytd`.
    /// Needs the `read-game` permission, except for the files the user
    /// handed to this call.
    read-file: func(vpath: string) -> result<list<u8>, string>;

    /// Lists a folder of the game ("" for the game folder itself).
    /// Needs the `read-game` permission.
    list-dir: func(vpath: string) -> result<list<dir-entry>, string>;

    /// Writes a line to OpenRAGE's log (shown by `openrage plugin`).
    log: func(level: level, message: string);

    /// A model of the game (`.ydr`, `.yft`, `.ydd` of every game OpenRAGE
    /// reads, also `.wdr`, `.wdd`, `.wft`) as the explorer shows it: the
    /// parts shown by default, placed in model space. Same permission rule
    /// as `read-file`.
    load-model: func(vpath: string) -> result<model, string>;

    /// A texture by name: from a texture dictionary (`.ytd`, `.wtd`), or one
    /// of a model's textures (embedded or next to it, as the explorer finds
    /// them). Same permission rule as `read-file`.
    load-texture: func(vpath: string, name: string) -> result<image, string>;

    /// Changes a file of the game, e.g. `x64a.rpf/data/lang/x.gxt2`. The
    /// change goes into the `mods` folder (archives are copied there first),
    /// never into the game's own files. Changes are applied together once
    /// the action has succeeded, as one change the user can undo; writing
    /// the same path twice keeps the last content.
    /// Needs the `write-mods` permission and works only in actions of kind
    /// `modify`.
    write-mod-file: func(vpath: string, data: list<u8>) -> result<_, string>;
}

world plugin {
    use types.{preview, input, output-file};

    import host;

    /// Shows a file of a type the plugin registered with `[[preview]]`.
    /// `vpath` names the file; `data` is its content.
    export preview: func(vpath: string, data: list<u8>) -> result<preview, string>;

    /// Runs one of the plugin's `[[action]]`s on the files the user picked.
    export run-action: func(action: string, inputs: list<input>) -> result<list<output-file>, string>;
}
